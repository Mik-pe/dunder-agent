capability network, filesystem, stdio, process
import http
import ..dogfood.competitors
import std.base64 as base64
import std.bytes as bytes
import std.fs as fs
import std.json as json
import std.net as net
import std.path as path
import std.process as process
import std.text as text
import sys

fn reply(req: &http.Request) -> string {
    assert(req.method == "POST" && req.target == "/api/experimental/generate/text")
    auth := "Basic " + base64.encode(&bytes.from_text("opencode:fixture"))
    assert(http.header(&req, "authorization") == auth)
    body := json.Doc::parse_text(bytes.decode(&req.body).unwrap())
    ref := body.field(body.root, "model")
    prompt := body.get_str(body.root, "prompt").unwrap()
    at := text.find(prompt, "\n{\"check\":").unwrap() + 1
    envelope := json.Doc::parse_text(prompt[at..prompt.len])
    events := envelope.field(envelope.root, "events")
    mut task := ""
    mut last := ""
    mut body_text := ""
    for i in 0..envelope.count(events) {
        e := envelope.at(events, i)
        last = envelope.get_str(e, "kind").unwrap()
        body_text = envelope.get_str(e, "body").unwrap()
        if last == "user" { task = body_text.clone() }
    }
    if task == "compile the Dunder example" || task == "open nested Dunder source" {
        skill := envelope.get_str(envelope.field(envelope.root, "skills"), "dunder")
        if last == "user" && task == "open nested Dunder source" {
            assert(skill.is_none())
            return r#"{"tool":"read_many","paths":["src/counter\u002eddr","note.txt"]}"#
        }
        if skill.is_none() { return r#"{"tool":"finish","blocked":true,"answer":"Missing Dunder example."}"# }
        if !text.starts_with(body_text, "exit 0, signal 0") {
            blocks := text.split(skill.unwrap(), "```dunder\n")
            source := text.split(blocks[1], "\n```")[0].clone()
            code := source + "\n@test fn numbered_label() { assert(numbered(\"åska\", 2147483647) == \"2147483648. åska\") }\n"
            return r#"{"tool":"create","path":"sample.ddr","content":"# + json.quote(code) + r#","check":true}"#
        }
        return r#"{"tool":"finish","answer":"Example compiled and ran."}"#
    }
    if task == "consult manual" {
        refs := envelope.field(envelope.root, "references")
        assert(envelope.count(refs) == 2 && envelope.as_str(envelope.at(refs, 0)).unwrap() == "language")
        if last == "user" { return r#"{"tool":"check"}"# }
        if text.contains(body_text, "unknown local 'let'") { return r#"{"tool":"search","reference":"language","query":"a new binding"}"# }
        if text.contains(body_text, "syntax.md:") { return r#"{"tool":"read","reference":"language","path":"syntax.md"}"# }
        if text.starts_with(body_text, "Create a new binding") { return r#"{"tool":"edit","path":"scratch.ddr","old":"let result = 40","new":"result := 40","check":true}"# }
        assert(text.starts_with(body_text, "exit 0, signal 0"))
        return r#"{"tool":"finish","answer":"Compiler passed."}"#
    }
    if task == "try closed manual" {
        if last == "user" { return r#"{"tool":"read","reference":"language","path":"syntax.md"}"# }
        assert(text.contains(body_text, "Unknown reference"))
        return r#"{"tool":"finish","answer":"Reference is closed."}"#
    }
    if task == "reference write" {
        if last == "user" { return r#"{"tool":"edit","reference":"language","path":"syntax.md","old":"shared","new":"wrong"}"# }
        assert(text.contains(body_text, "read-only"))
        return r#"{"tool":"finish","answer":"Write rejected."}"#
    }
    if task == "repair from the check log" {
        if last == "user" { return r#"{"tool":"check"}"# }
        assert(body_text.len <= 16000 && text.contains(body_text, "bytes omitted"))
        assert(text.contains(body_text, "build started") && text.contains(body_text, "build ended"))
        if text.starts_with(body_text, "exit 3, signal 0\n") {
            assert(text.contains(body_text, "stderr:") && text.ends_with(body_text, "wrong value in level.txt\n"))
            return r#"{"tool":"edit","path":"level.txt","old":"3","new":"4","check":true}"#
        }
        assert(text.starts_with(body_text, "exit 0, signal 0\n") && text.ends_with(body_text, "tests passed\n"))
        return r#"{"tool":"finish","answer":"Level verified."}"#
    }
    if task == "model variant" {
        assert(body.get_str(ref, "providerID").unwrap() == "fixture" && body.get_str(ref, "id").unwrap() == "vendor/model" && body.get_str(ref, "variant").unwrap() == "low")
        return r#"{"tool":"finish","answer":"Variant received."}"#
    }
    assert(body.get_str(ref, "id").unwrap() == "glm-5.4" && body.get_str(ref, "variant").is_none())
    if task == "leave pending" { return r#"{"tool":"edit","path":"note.txt","old":"old","new":"unverified"}"# }
    if task == "  fortsätt ⚡\r\nrad två\n\n" || (task.len == 32768 && task == text.pad_left("å", 32767, "x")) { return r#"{"tool":"finish","answer":"Continued."}"# }
    if task == "continue now" { return r#"{"tool":"finish","answer":"Continued."}"# }
    if task == "group edits" || task == "stale group" {
        if last == "user" {
            old := if task == "stale group" { "stale" } else { "second" }
            return r#"{"tool":"edit_many","edits":[{"path":"note.txt","old":"first","new":"prefix"},{"path":"b.txt","old":"# + json.quote(old) + r#","new":"done"},{"path":"note.txt","old":"prefix","new":"verified"}],"check":true}"#
        }
        if task == "stale group" {
            assert(text.contains(body_text, "b.txt") && text.contains(body_text, "no longer matches"))
            return r#"{"tool":"finish","blocked":true,"answer":"Edit conflict."}"#
        }
        assert(text.starts_with(body_text, "exit 0, signal 0"))
        return r#"{"tool":"finish","answer":"Group checked."}"#
    }
    if task == "one batch" {
        assert(text.contains(envelope.get_str(envelope.root, "rootEntriesAtTurnStart").unwrap(), "note.txt"))
        if last == "user" { return r#"{"tool":"read_many","paths":["note.txt","absent"]}"# }
        if text.starts_with(body_text, "[") {
            files := json.Doc::parse_text(body_text)
            assert(files.get_str(files.at(files.root, 0), "content").unwrap() == "old")
            assert(files.get_str(files.at(files.root, 1), "error").is_some())
            return r#"{"tool":"edit","path":"note.txt","old":"old","new":"checked","check":true}"#
        }
        assert(text.starts_with(body_text, "exit 0, signal 0"))
        return r#"{"tool":"finish","answer":"Checked."}"#
    }
    if task == "follow up" {
        assert(envelope.count(events) >= 7)
        return r#"{"tool":"finish","answer":"Resumed."}"#
    }
    if task == "blocked" { return r#"{"tool":"finish","blocked":true,"answer":"Missing input."}"# }
    if task == "slow reply" { sys.sleep_ms(1500); return r#"{"tool":"finish","answer":"Slow."}"# }
    if task == "wait" { sys.sleep_ms(12000); return r#"{"tool":"finish","answer":"Done."}"# }
    if task == "budget" { return r#"{"tool":"list","path":"."}"# }
    if task == "shell" {
        if last == "user" { return r#"{"tool":"shell","command":"printf approved > approved.txt"}"# }
        return r#"{"tool":"finish","answer":"Shell turn complete."}"#
    }
    if last == "user" { return r#"{"tool":"read","path":"note.txt"}"# }
    if body_text == "old" { return r#"{"tool":"edit","path":"note.txt","old":"old","new":"new"}"# }
    r#"{"tool":"finish","answer":"Done."}"#
}

fn serve(dir: string) -> i32 {
    listener := net.TcpListener::listen_addr(net.SocketAddr::loopback_v4(0), 8).unwrap()
    assert(fs.mkdir_all(path.join(dir, "opencode")).ok)
    reg := r#"{"password":"fixture","url":"http://127.0.0.1:"# + listener.local_port().str() + "\"}"
    assert(fs.write_private_text_atomic(path.join(dir, "opencode/service.json"), reg).is_ok())
    print("ready")
    while true {
        stream := listener.accept().unwrap()
        req := http.read_request(&stream, 1048576, 3000)
        if req.ok {
            answer := r#"{"data":{"text":"# + json.quote(reply(&req)) + "}}"
            _ := http.write_response(&stream, 200, "application/json", [], [], &bytes.from_text(answer), false)
        }
    }
    0
}

fn command(app: string, dir: string, args: []string) -> process.Command {
    mut cmd := process.Command::new(app.clone(), args.clone())
    cmd.set_cwd(dir.clone())
    cmd.set_env("XDG_STATE_HOME", path.join(dir, "state"))
    cmd.set_timeout(8000)
    cmd
}

fn run(app: string, dir: string, args: []string) -> process.Output {
    command(app, dir, args).exec()
}

fn check_transcript(app: string, dir: string) {
    assert(sys.write(path.join(dir, "note.txt"), "old").is_ok())
    live := run(app, dir, ["--jsonl", "--check", "test \"$(cat note.txt)\" = new && echo verified", "run", "repair"])
    assert(live.succeeded() && live.stderr.len == 0)
    rows := text.split(text.trim(live.stdout_text()), "\n")
    first := json.Doc::parse_text(rows[0])
    assert(first.get_str(first.root, "type").unwrap() == "session" && first.get_str(first.root, "root").unwrap() == fs.realpath(dir).value)
    id := first.get_str(first.root, "id").unwrap()
    file := path.join(path.join(dir, "state/dunder-agent"), id + ".json")
    original := sys.read(file).unwrap()
    saved := json.Doc::parse_text(original)
    events := saved.field(saved.root, "events")
    count := saved.count(events)
    assert(count > 4 && rows.len == count + 2)
    for i in 0..count {
        row := json.Doc::parse_text(rows[i + 1])
        e := saved.at(events, i)
        assert(row.get_str(row.root, "type").unwrap() == "event" && row.get_i64(row.root, "index").unwrap() == i64(i))
        assert(row.get_str(row.root, "kind").unwrap() == saved.get_str(e, "kind").unwrap() && row.get_str(row.root, "body").unwrap() == saved.get_str(e, "body").unwrap())
    }
    last := json.Doc::parse_text(rows[rows.len - 1])
    assert(last.get_str(last.root, "type").unwrap() == "end" && last.get_bool(last.root, "success").unwrap())
    replay := run(app, dir, ["show", id.clone(), "--jsonl"])
    assert(replay.succeeded() && replay.stderr.len == 0 && replay.stdout_text() + rows[rows.len - 1] + "\n" == live.stdout_text())
    human := run(app, dir, ["show", id.clone()])
    assert(human.succeeded() && text.contains(human.stdout_text(), "[result]\nexit 0, signal 0\nverified") && text.contains(human.stdout_text(), "[assistant]\nDone."))
    assert(sys.read(file).unwrap() == original)
    resumed := run(app, dir, ["--resume", id, "--jsonl", "run", "blocked"])
    more := text.split(text.trim(resumed.stdout_text()), "\n")
    assert(resumed.code == 1 && more.len == 4 && more[0] == rows[0])
    next := json.Doc::parse_text(more[1])
    assert(next.get_i64(next.root, "index").unwrap() == i64(count) && next.get_str(next.root, "body").unwrap() == "blocked")
    end := json.Doc::parse_text(more[3])
    assert(!end.get_bool(end.root, "success").unwrap() && end.get_str(end.root, "status").unwrap() == "Task blocked")
}

fn check_stdin(app: string, dir: string) {
    mut cmd := command(app, dir, ["run", "-"])
    cmd.set_stdin_text("  fortsätt ⚡\r\nrad två\n\n")
    first := cmd.exec()
    assert(first.succeeded() && first.stdout_text() == "Continued.\n")
    id := text.split(text.split(first.stderr_text(), "\n")[0], " ")[1].clone()
    mut resumed := command(app, dir, ["--resume", id.clone(), "run", "-"])
    boundary := text.pad_left("å", 32767, "x")
    assert(boundary.len == 32768)
    resumed.set_stdin_text(boundary)
    second := resumed.exec()
    assert(second.succeeded() && second.stdout_text() == "Continued.\n")
    session_dir := path.join(dir, "state/dunder-agent")
    count := fs.list_dir(session_dir).unwrap().len
    for invalid in ["", " \n\t", boundary + "!"] {
        cmd.set_stdin_text(invalid)
        failed := cmd.exec()
        assert(failed.code == 2 && !text.contains(failed.stderr_text(), "Session "))
    }
    cmd.set_stdin([u8(255)])
    assert(cmd.exec().code == 2)
    mut bad := command(app, dir, ["run", "-", "--bad"])
    bad.set_stdio(.Pipe, .Pipe, .Pipe)
    mut child := bad.spawn().unwrap()
    end := child.wait(2000)
    assert(end.exited && !end.timed_out && end.code == 2)
    assert(fs.list_dir(session_dir).unwrap().len == count)
}

fn check_dunder_example(app: string, dir: string) {
    for kind in ["nested", "source", "manifest", "explicit"] {
        work := path.join(dir, kind)
        assert(fs.mkdir_all(path.join(work, "src")).ok)
        file := if kind == "source" { "counter.ddr" } else if kind == "manifest" { "dunder.toml" } else { "src/counter.ddr" }
        content := if kind == "manifest" { "name = \"demo\"\nversion = \"0.1.0\"\nroot = \"sample.ddr\"\n" } else { "fn counter() -> i32 { 1 }\n" }
        assert(sys.write(path.join(work, file), content).is_ok())
        task := if kind == "nested" { "open nested Dunder source" } else { "compile the Dunder example" }
        mut args: []string = ["--workspace", work.clone(), "--check", "dunder test sample.ddr --offline", "--max-steps", "3", "run", task.clone()]
        if kind == "explicit" { args.push("--skill"); args.push("dunder") }
        turn := run(app, dir, args)
        assert(turn.succeeded() && turn.stdout_text() == "Example compiled and ran.\n")
        assert(text.contains(turn.stderr_text(), "check exit 0") && text.contains(sys.read(path.join(work, "sample.ddr")).unwrap(), "number.str()"))
    }
}

fn main() -> i32 {
    if sys.arg_count() == 3 && sys.arg(1) == "--serve" { return serve(sys.arg(2)) }
    if sys.arg_count() != 2 { _ := sys.eprint("Pass the path to the compiled dunder-agent."); return 2 }
    app := fs.realpath(sys.arg(1)).value
    dir := fs.temp_dir("dunder-loop-test-").value
    defer { _ := fs.remove_all(dir) }
    mascot := run(app, dir, ["mascot"])
    assert(mascot.succeeded() && mascot.stdout_text() == "Muller  ϟ ◢(•‿•)◣\n" && mascot.stderr.len == 0)
    assert(text.contains(run(app, dir, ["--help"]).stdout_text(), "dunder-agent mascot"))
    state := path.join(dir, "state")
    cmd := process.Command::new(sys.arg(0), ["--serve", state.clone()])
    mut server := cmd.spawn().unwrap()
    defer { _ := server.kill(); _ := server.wait(1000) }
    assert(server.read_stdout_line(5000).unwrap().is_some())
    exported := run(app, dir, ["skill", "dunder"])
    assert(exported.succeeded() && exported.stdout_text() == @embed_file(".agents/skills/dunder/SKILL.md") && exported.stderr.len == 0)
    assert(run(app, dir, ["skill", "absent"]).code == 2 && run(app, dir, ["--skill", "absent", "run", "unused"]).code == 2)
    check_dunder_example(app, dir)
    check_stdin(app, dir)
    check_transcript(app, dir)
    assert(sys.write(path.join(dir, "level.txt"), "3").is_ok())
    log := "printf 'build started\n'; awk 'BEGIN {for (i=0;i<100000;i++) print \"compiling module\"}'; printf 'build ended\n'; "
    verify_level := log + "if test \"$(cat level.txt)\" = 4; then echo 'tests passed'; else printf '\\377wrong value in level.txt\n' >&2; exit 3; fi"
    repaired := run(app, dir, ["--check", verify_level.clone(), "run", "repair from the check log"])
    assert(repaired.succeeded() && repaired.stdout_text() == "Level verified.\n")
    assert(text.contains(repaired.stderr_text(), "check exit 3") && text.contains(repaired.stderr_text(), "wrong value in level.txt"))
    assert(text.contains(repaired.stderr_text(), "check exit 0") && sys.read(path.join(dir, "level.txt")).unwrap() == "4")
    selected := run(app, dir, ["--model", "fixture/vendor/model#low", "run", "model variant"])
    assert(selected.succeeded() && selected.stdout_text() == "Variant received.\n")
    rejected := run(app, dir, ["--model", "fixture/m#", "run", "unreachable"])
    assert(rejected.code == 2 && !text.contains(rejected.stderr_text(), "Session "))
    manual := fs.temp_dir("dunder-manual-").value
    defer { _ := fs.remove_all(manual) }
    doc := path.join(manual, "syntax.md")
    assert(sys.write(doc, "Create a new binding with name := value. shared").is_ok())
    assert(sys.write(path.join(dir, "syntax.md"), "shared").is_ok())
    code := path.join(dir, "scratch.ddr")
    assert(sys.write(code, "fn main() { let result = 40; assert(result + 2 == 42) }").is_ok())
    consulted := run(app, dir, ["--reference", "language=" + manual, "--reference", "other=" + manual, "--check", "dunder check scratch.ddr --offline --locked", "run", "consult manual"])
    assert(consulted.succeeded() && consulted.stdout_text() == "Compiler passed.\n")
    assert(text.contains(consulted.stderr_text(), "read [language] syntax.md") && text.contains(sys.read(code).unwrap(), "result := 40"))
    consult_id := text.split(text.split(consulted.stderr_text(), "\n")[0], " ")[1].clone()
    closed := run(app, dir, ["--resume", consult_id, "run", "try closed manual"])
    assert(closed.succeeded() && closed.stdout_text() == "Reference is closed.\n")
    protected := run(app, dir, ["--reference", "language=" + manual, "run", "reference write"])
    assert(protected.succeeded() && protected.stdout_text() == "Write rejected.\n")
    assert(sys.read(doc).unwrap() == "Create a new binding with name := value. shared" && sys.read(path.join(dir, "syntax.md")).unwrap() == "shared")
    note := path.join(dir, "note.txt")
    assert(sys.write(note, "first").is_ok())
    second := path.join(dir, "b.txt")
    assert(sys.write(second, "second").is_ok())
    verify := "test \"$(cat note.txt)\" = verified && test \"$(cat b.txt)\" = done && echo passed >> checks"
    stale := run(app, dir, ["--check", verify.clone(), "--max-steps", "2", "run", "stale group"])
    assert(!stale.succeeded() && stale.stdout_text() == "Edit conflict.\n")
    assert(sys.read(note).unwrap() == "first" && sys.read(second).unwrap() == "second" && !sys.metadata(path.join(dir, "checks")).ok)
    group := run(app, dir, ["--check", verify.clone(), "--max-steps", "2", "run", "group edits"])
    assert(group.succeeded() && group.stdout_text() == "Group checked.\n")
    assert(sys.read(note).unwrap() == "verified" && sys.read(second).unwrap() == "done" && sys.read(path.join(dir, "checks")).unwrap() == "passed\n")
    group_id := text.split(text.split(group.stderr_text(), "\n")[0], " ")[1].clone()
    shown := run(app, dir, ["changes", group_id])
    assert(shown.stdout_text() == "edit note.txt\n- first\n+ prefix\n\nedit b.txt\n- second\n+ done\n\nedit note.txt\n- prefix\n+ verified\n")
    assert(sys.write(note, "old").is_ok())
    batched := run(app, dir, ["--check", "test \"$(cat note.txt)\" = checked", "--max-steps", "3", "run", "one batch"])
    assert(batched.succeeded() && batched.stdout_text() == "Checked.\n")
    assert(text.contains(batched.stderr_text(), "check exit 0"))
    assert(sys.write(note, "old").is_ok())
    turn := run(app, dir, ["--check", "test \"$(cat note.txt)\" = new", "run", "repair"])
    assert(turn.succeeded())
    assert(turn.stdout_text() == "Done.\n" && !text.contains(turn.stderr_text(), "\u{1b}"))
    assert(sys.read(note).unwrap() == "new")
    assert(text.contains(turn.stderr_text(), "check exit 0"))
    id := text.split(text.split(turn.stderr_text(), "\n")[0], " ")[1].clone()
    edits := run(app, dir, ["changes", id.clone()])
    assert(edits.succeeded() && edits.stdout_text() == "edit note.txt\n- old\n+ new\n")
    assert(!run(app, dir, ["--workspace", state.clone(), "changes", id.clone()]).succeeded())
    assert(text.contains(run(app, dir, ["--sessions"]).stdout_text(), id))
    assert(!run(app, dir, ["run", "blocked"]).succeeded())
    assert(run(app, dir, ["--resume", id.clone(), "run", "follow up", "--plain"]).stdout_text() == "Resumed.\n")
    assert(sys.write(note, "old").is_ok())
    failed := run(app, dir, ["--check", "exit 7", "run", "repair"])
    assert(!failed.succeeded() && text.contains(failed.stderr_text(), "check exit 7"))
    assert(run(app, dir, ["run", "shell"]).succeeded())
    assert(!sys.metadata(path.join(dir, "approved.txt")).ok)
    budget := run(app, dir, ["--max-steps", "2", "run", "budget"])
    assert(!budget.succeeded() && text.contains(budget.stderr_text(), "2-decision limit"))
    assert(sys.write(note, "old").is_ok())
    pending := run(app, dir, ["--max-steps", "1", "run", "leave pending"])
    assert(!pending.succeeded() && sys.read(note).unwrap() == "unverified")
    pending_id := text.split(text.split(pending.stderr_text(), "\n")[0], " ")[1].clone()
    retry := run(app, dir, ["--resume", pending_id.clone(), "--check", "test \"$(cat note.txt)\" = unverified && printf verified > checked.txt", "run", "continue now"])
    assert(retry.succeeded() && text.contains(retry.stderr_text(), "check exit 0") && sys.metadata(path.join(dir, "checked.txt")).is_file)
    timed_model := run(app, dir, ["--model-timeout", "1", "run", "slow reply"])
    assert(!timed_model.succeeded() && text.contains(timed_model.stderr_text(), "model request timed out after 1 s."))
    allowed_model := run(app, dir, ["--model-timeout", "4", "run", "slow reply"])
    assert(allowed_model.succeeded() && allowed_model.stdout_text() == "Slow.\n")
    for value in ["0", "-1", "4s", "2147483648"] {
        invalid := run(app, dir, ["--model-timeout", value.clone(), "run", "unused"])
        assert(invalid.code == 2 && !text.contains(invalid.stderr_text(), "Session "))
    }
    scratch := path.join(dir, "scratch")
    assert(fs.mkdir_all(scratch).ok)
    mut timed := competitors.command("dunder", app, dir, dir, "wait", "", 1200).unwrap()
    timed.set_env("XDG_STATE_HOME", state.clone())
    timed.set_env("TMPDIR", scratch.clone())
    expired := timed.exec()
    assert(expired.code == 124 && text.contains(expired.stderr_text(), "Cancelled"))
    assert(fs.list_dir(scratch).unwrap().len == 0)
    print("PASS mascot, CLI help, stdin tasks, stream and replay, repair from noisy diagnostics, pipe output, reference lookup and compiler repair, single and grouped edits, stale preflight, automatic check, resume, failed check, shell permission, model variant, model timeout, decision budget, deadline cancellation")
    0
}
