capability filesystem, process
import ..src.workspace
import ..src.reference
import ..src.review
import ..src.session
import ..src.provider
import ..src.output
import std.bytes as bytes
import std.json as json
import std.fs as fs
import std.path as path
import std.text as text
import std.process as process
import sys

fn tool(root: string, args: string) -> Result<string, string> {
    parsed := json.Doc::parse_text(args)
    workspace.execute(root, &parsed)
}

@test fn truncate_unicode() {
    assert(workspace.clip("åäö", 3) == "å\n[truncated]")
}

@test fn command_log_keeps_utf8_edges_through_short_reads() {
    mut stream := output.Stream::new()
    chunk := bytes.from_text(text.pad_right("åskväder", 379, "⚡"))
    for _ in 0..150 {
        bytes.extend(&mut stream.data, &chunk)
        stream.received(i64(chunk.len), true)
        assert(stream.data.len <= output.LIMIT)
    }
    assert(stream.total == i64(chunk.len) * 150)
    empty := output.Stream::new()
    summary := output.report("exit 0, signal 0", &stream, &empty)
    assert(summary.len <= output.LIMIT && text.starts_with(summary, "exit 0, signal 0\nåskväder"))
    assert(text.ends_with(summary, "⚡") && !text.contains(summary, "?"))
    preview := output.preview(summary, 360)
    assert(preview.len <= 360 && text.starts_with(preview, "exit 0, signal 0") && text.ends_with(preview, "⚡"))
    assert(text.contains(preview, "bytes omitted") && !text.contains(preview, "?"))
}

@test fn mixed_command_streams_keep_malformed_bytes_local() {
    out := output.Stream { data: [u8(97), 255, 98], total: 3 }
    err := output.Stream { data: bytes.from_text("diagnos"), total: 7 }
    report := output.report("exit 8, signal 0", &out, &err)
    assert(report == "exit 8, signal 0\nstdout:\na?b\nstderr:\ndiagnos")
}

@test fn create_and_edit_preserve_neighbours_and_mode() {
    dir := fs.temp_dir("dunder-file-test-").value
    defer { _ := fs.remove_all(dir) }
    action := r#"{"tool":"create","path":"src/demo","content":"åäö\n"}"#
    assert(tool(dir, action).is_ok())
    assert(tool(dir, action).is_err())
    file := path.join(dir, "src/demo")
    assert(fs.chmod(file, 493).is_ok())
    assert(tool(dir, r#"{"tool":"edit","path":"src/demo","old":"ä","new":" A "}"#).is_ok())
    assert(sys.read(file).unwrap() == "å A ö\n")
    assert(sys.metadata(file).mode.bit_and(511) == 493)
}

@test fn ambiguous_stale_and_missing_edits_preserve_file() {
    dir := fs.temp_dir("dunder-edit-test-").value
    defer { _ := fs.remove_all(dir) }
    file := path.join(dir, "note")
    assert(sys.write(file, "ååå").is_ok())
    assert(tool(dir, r#"{"tool":"edit","path":"note","old":"åå","new":"x"}"#).is_err())
    assert(tool(dir, r#"{"tool":"edit","path":"note","old":"stale","new":"x"}"#).is_err())
    assert(tool(dir, r#"{"tool":"edit","path":"note","old":"ååå"}"#).is_err())
    assert(sys.read(file).unwrap() == "ååå")
}

@test fn file_tools_reject_escapes_and_symlinks() {
    dir := fs.temp_dir("dunder-path-test-").value
    defer { _ := fs.remove_all(dir) }
    assert(fs.symlink("/tmp", path.join(dir, "link")).ok)
    for name in ["../notes", "/tmp/notes", ".git/config", "link/notes", "a/../b", "a\\b", "bad\u{0}path"] {
        assert(tool(dir, r#"{"tool":"create","content":"","path":"# + json.quote(name) + "}").is_err())
    }
    assert(tool(dir, r#"{"tool":"list","path":"link"}"#).is_err())
    assert(tool(dir, r#"{"tool":"read","path":"link/notes"}"#).is_err())
}

@test fn read_reports_utf8_continuation_offset() {
    dir := fs.temp_dir("dunder-read-test-").value
    defer { _ := fs.remove_all(dir) }
    contents := text.pad_left("å", 16000, "x") + "!"
    assert(sys.write(path.join(dir, "note"), contents).is_ok())
    first := tool(dir, r#"{"tool":"read","path":"note"}"#).unwrap()
    assert(text.ends_with(first, "[continue at byte 15999]"))
    assert(tool(dir, r#"{"tool":"read","path":"note","offset":15999}"#).unwrap() == "å!")
    assert(tool(dir, r#"{"tool":"read","path":"note","offset":16000}"#).is_err())
}

@test fn search_literal_and_directory_listing() {
    dir := fs.temp_dir("dunder-search-test-").value
    defer { _ := fs.remove_all(dir) }
    assert(sys.write(path.join(dir, "notes"), "first\na.b\n").is_ok())
    assert(tool(dir, r#"{"tool":"list"}"#).unwrap() == "notes")
    assert(text.contains(tool(dir, r#"{"tool":"search","query":"a.b"}"#).unwrap(), "notes:2:a.b"))
    assert(tool(dir, r#"{"tool":"search","query":"a?b"}"#).unwrap() == "No matches.")
}

@test fn git_listing_shows_tracked_and_nonignored_entries() {
    dir := fs.temp_dir("dunder-git-list-test-").value
    defer { _ := fs.remove_all(dir) }
    assert(process.run_in("git", ["init", "-q"], dir).succeeded())
    assert(sys.write(path.join(dir, ".gitignore"), "build/\n*.o\n").is_ok())
    assert(fs.mkdir_all(path.join(dir, "build/nested")).ok)
    assert(sys.write(path.join(dir, "build/nested/kept"), "x\n").is_ok())
    assert(sys.write(path.join(dir, "build/skip"), "x\n").is_ok())
    assert(sys.write(path.join(dir, "code.o"), "x\n").is_ok())
    assert(sys.write(path.join(dir, "notes"), "x\n").is_ok())
    assert(process.run_in("git", ["add", "-f", "build/nested/kept", "notes", ".gitignore"], dir).succeeded())
    assert(sys.write(path.join(dir, "Önskelista"), "ok").is_ok())
    assert(workspace.listing(dir).unwrap() == ".gitignore\nbuild/\nnotes\nÖnskelista")
    assert(workspace.listing(path.join(dir, "build")).unwrap() == "nested/")
    assert(sys.remove_file(path.join(dir, "build/nested/kept")).ok)
    assert(sys.remove_file(path.join(dir, "notes")).ok)
    assert(workspace.listing(dir).unwrap() == ".gitignore\nÖnskelista")
    assert(workspace.listing(path.join(dir, "build")).unwrap() == "")
}

@test fn provider_requires_complete_text_decision() {
    reply := r#"{"tool":"finish","answer":"å"}"#
    assert(provider.decision(r#"{"data":{"text":"# + json.quote(reply) + "}}").unwrap() == reply)
    assert(provider.decision("{}").is_err())
    assert(provider.decision(r#"{"data":{"text":"partial"}}"#).is_err())
    assert(provider.local_url("http://127.0.0.1:49374"))
    assert(!provider.local_url("http://127.0.0.1:80@elsewhere"))
    assert(!provider.local_url("http://example.org:80"))
}

@test fn private_session_roundtrip_and_workspace_binding() {
    dir := fs.temp_dir("dunder-state-test-").value
    defer { _ := fs.remove_all(dir) }
    file := session.file_for(dir, "123-45").unwrap()
    assert(session.file_for(dir, "../x").is_err())
    mut state := session.Session { root: dir.clone(), events: [] }
    assert(session.record(&mut state, file, "user", "hello").is_ok())
    loaded := session.resume(file, dir).unwrap()
    assert(loaded.events[0].body == "hello")
    assert(sys.metadata(file).mode.bit_and(511) == 384)
    assert(session.resume(file, "/another-repo").is_err())
}

@test fn read_many_preserves_paths_partial_errors_and_utf8_offsets() {
    dir := fs.temp_dir("dunder-batch-read-").value
    defer { _ := fs.remove_all(dir) }
    assert(sys.write(path.join(dir, "a"), text.pad_left("å", 4096, "x") + "z").is_ok())
    assert(sys.write(path.join(dir, "b"), "line one\nline two").is_ok())
    assert(fs.symlink(dir, path.join(dir, "symlink")).ok)
    raw := tool(dir, r#"{"tool":"read_many","paths":["b","../bad","a","symlink/b"]}"#).unwrap()
    replies := json.Doc::parse_text(raw)
    assert(replies.count(replies.root) == 4)
    assert(replies.get_str(replies.at(replies.root, 0), "content").unwrap() == "line one\nline two")
    assert(replies.get_str(replies.at(replies.root, 1), "error").is_some())
    long_file := replies.at(replies.root, 2)
    assert(replies.get_str(long_file, "path").unwrap() == "a")
    assert(text.ends_with(replies.get_str(long_file, "content").unwrap(), "[continue at byte 4095]"))
    assert(replies.get_str(replies.at(replies.root, 3), "error").is_some())
    assert(tool(dir, r#"{"tool":"read_many","paths":[]}"#).is_err())
    assert(tool(dir, r#"{"tool":"read_many","paths":["a","a","a","a","a","a","a","a","a"]}"#).is_err())
}

@test fn verification_survives_interruptions_and_ignores_rejected_writes() {
    mut state := session.Session { root: ".", events: [] }
    state.events.push(session.Event { kind: "action", body: r#"{"tool":"edit"}"# })
    state.events.push(session.Event { kind: "result", body: "Error: Old text no longer matches. Read the file again." })
    assert(!session.requires_check(&state))
    state.events.push(session.Event { kind: "action", body: r#"{"tool":"create"}"# })
    state.events.push(session.Event { kind: "notice", body: "Turn cancelled." })
    assert(session.requires_check(&state))
    state.events.push(session.Event { kind: "action", body: r#"{"tool":"check"}"# })
    state.events.push(session.Event { kind: "result", body: "exit 0, signal 0\ngreen" })
    state.events.push(session.Event { kind: "action", body: r#"{"tool":"shell"}"# })
    state.events.push(session.Event { kind: "result", body: "Error: Command declined by user." })
    assert(!session.requires_check(&state))
    state.events.push(session.Event { kind: "action", body: r#"{"tool":"shell"}"# })
    state.events.push(session.Event { kind: "result", body: "Error: Command exceeded its time or output limit." })
    assert(session.requires_check(&state))
    state.events.push(session.Event { kind: "action", body: r#"{"tool":"check"}"# })
    state.events.push(session.Event { kind: "result", body: "exit 1, signal 0\nred" })
    assert(session.requires_check(&state))
}

@test fn session_review_shows_confirmed_edits_in_order() {
    mut s := session.Session { root: ".", events: [] }
    assert(review.changes(&s) == "No saved file edits in this session.")
    s.events.push(session.Event { kind: "action", body: r#"{"tool":"create","path":"a","content":"one\n\ntwo\n"}"# })
    s.events.push(session.Event { kind: "result", body: "Saved." })
    s.events.push(session.Event { kind: "action", body: r#"{"tool":"edit","path":"a","old":"missing","new":"unsaved"}"# })
    s.events.push(session.Event { kind: "result", body: "Error: Old text no longer matches." })
    s.events.push(session.Event { kind: "action", body: r#"{"tool":"edit","path":"a","old":"one","new":""}"# })
    s.events.push(session.Event { kind: "result", body: "Saved." })
    s.events.push(session.Event { kind: "action", body: r#"{"tool":"create","path":"empty","content":""}"# })
    s.events.push(session.Event { kind: "result", body: "Saved." })
    s.events.push(session.Event { kind: "action", body: r#"{"tool":"create","path":"interrupted","content":"pending"}"# })
    assert(review.changes(&s) == "create a\n+ one\n+ \n+ two\n\nedit a\n- one\n\ncreate empty")
}

@test fn review_exposes_changed_line_endings_and_control_bytes() {
    mut state := session.Session { root: ".", events: [] }
    state.events.push(session.Event { kind: "action", body: r#"{"tool":"edit","path":"file","old":"word\r\n","new":"word"}"# })
    state.events.push(session.Event { kind: "result", body: "Saved." })
    state.events.push(session.Event { kind: "action", body: r#"{"tool":"create","path":"other","content":"\u001b[2J"}"# })
    state.events.push(session.Event { kind: "result", body: "Saved." })
    assert(review.changes(&state) == "edit file\n- word\\r\n+ word\n  [old fragment ends with LF]\n\ncreate other\n+ \\x1b[2J\n  [no newline at end of file]")
    assert(review.visible("a\u{0}\u{85}b\t⚡") == "a\\x00\\x85b\t⚡")
}

@test fn model_references_preserve_nested_ids_and_separate_the_variant() {
    raw := provider.model_ref("fixture/vendor/model#low").unwrap()
    doc := json.Doc::parse_text(raw)
    assert(doc.get_str(doc.root, "providerID").unwrap() == "fixture")
    assert(doc.get_str(doc.root, "id").unwrap() == "vendor/model")
    assert(doc.get_str(doc.root, "variant").unwrap() == "low")
    base := json.Doc::parse_text(provider.model_ref(provider.MODEL).unwrap())
    assert(base.get_str(base.root, "id").unwrap() == "glm-5.4" && base.get_str(base.root, "variant").is_none())
    for name in ["model", "/model", "provider/", "provider/#low", "provider/model#", "provider/model#low#high", "prov#x/model"] {
        assert(provider.model_ref(name).is_err())
    }
}

@test fn dunder_skill_follows_workspace_paths_across_turns() {
    mut state := session.Session { root: ".", events: [] }
    for raw in [
        r#"{"tool":"read","path":"demo.ddr","reference":"manual"}"#,
        r#"{"tool":"search","query":"dunder.toml"}"#,
        r#"{"tool":"create","path":"README.md","content":"see demo.ddr"}"#,
    ] {
        state.events.push(session.Event { kind: "action", body: raw.clone() })
    }
    assert(!provider.uses_dunder("demo.ddr/\ndunder.toml.bak", &state))
    assert(provider.uses_dunder("demo.ddr", &state) && provider.uses_dunder("dunder.toml", &state))
    state.events.push(session.Event { kind: "action", body: r#"{"tool":"read","path":"src/rows\u002eddr"}"# })
    assert(provider.uses_dunder("src/", &state))
}

@test fn edit_plan_checks_paths_matches_and_limits_before_writing() {
    dir := fs.temp_dir("dunder-edit-plan-").value
    defer { _ := fs.remove_all(dir) }
    assert(sys.write(path.join(dir, "file"), "ababa").is_ok())
    assert(fs.symlink("file", path.join(dir, "link")).ok)
    for raw in [
        r#"{"edits":[{"path":"link","old":"ababa","new":"x"}]}"#,
        r#"{"edits":[{"path":"../file","old":"ababa","new":"x"}]}"#,
        r#"{"edits":[{"path":"file","old":"aba","new":"x"}]}"#,
        r#"{"edits":[{"path":"file","old":"","new":"x"}]}"#,
        r#"{"edits":[{"path":"file","old":"ababa"}]}"#,
        r#"{"edits":[]}"#, r#"{"edits":[1,2,3,4,5,6,7,8,9]}"#,
    ] {
        doc := json.Doc::parse_text(raw)
        assert(workspace.edit_plan(dir, &doc).is_err())
    }
    assert(sys.read(path.join(dir, "file")).unwrap() == "ababa")
}

@test fn references_preserve_the_directory_boundary_and_reject_ambiguous_names() {
    dir := fs.temp_dir("dunder-references-").value
    defer { _ := fs.remove_all(dir) }
    docs := path.join(dir, "docs=example")
    assert(fs.mkdir_all(docs).ok)
    assert(sys.write(path.join(docs, "entry"), "manual").is_ok())
    assert(sys.write(path.join(dir, "outside"), "outside").is_ok())
    assert(fs.symlink("../outside", path.join(docs, "link")).ok)
    mut refs: []reference.Reference = []
    assert(reference.add(&mut refs, "manual=" + docs).is_ok())
    for invalid in ["manual=" + dir, "two names=" + docs, "=empty", "missing", "name=", "file=" + path.join(dir, "outside")] {
        assert(reference.add(&mut refs, invalid).is_err())
    }
    list := json.Doc::parse_text(r#"{"tool":"list","reference":"manual","path":"."}"#)
    assert(reference.inspect(&refs, &list).unwrap() == "entry")
    read := json.Doc::parse_text(r#"{"tool":"read_many","reference":"manual","paths":["entry","../outside","link"]}"#)
    result := json.Doc::parse_text(reference.inspect(&refs, &read).unwrap())
    assert(result.get_str(result.at(result.root, 0), "content").unwrap() == "manual")
    assert(result.get_str(result.at(result.root, 1), "error").is_some() && result.get_str(result.at(result.root, 2), "error").is_some())
    for name in ["edit", "edit_many", "create", "shell", "check"] {
        command := json.Doc::parse_text(r#"{"reference":"manual","tool":"# + json.quote(name) + "}")
        assert(reference.inspect(&refs, &command).is_err())
    }
    batch := json.Doc::parse_text(r#"{"edits":[{"reference":"manual","path":"entry","old":"manual","new":"wrong"}]}"#)
    assert(workspace.edit_plan(docs, &batch).is_err())
    assert(sys.rename(docs, path.join(dir, "original")).ok && fs.symlink(dir, docs).ok)
    assert(reference.inspect(&refs, &list).is_err())
}
