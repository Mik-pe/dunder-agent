capability filesystem, process, stdio
import .corpus
import .competitors
import .quota as quota_time
import std.time as clock
import std.fs as fs
import std.json as json
import std.path as path
import std.process as process
import std.text as text
import sys

fn fake_trial() -> i32 {
    name := sys.arg(1)
    peer := sys.arg(2)
    rep := sys.arg(4)
    out := sys.arg(5)
    assert(fs.mkdir_all(out).ok)
    fixture := path.join("dogfood/cases", name)
    work := fs.temp_dir("series-fake-").value
    defer { _ := fs.remove_all(work) }
    tree := corpus.seed(fixture, path.join(work, "work"))
    retry := path.basename(out) == "retry-1"
    repeat := sys.metadata("repeat-limit").ok
    quota := name == "a" && rep == "1" && (!retry || repeat)
    reason := if quota && peer == "pi" { "missing-final-check" } else if quota && peer == "goose" { "harness-error" } else if quota { "provider-error" } else if name == "a" && rep == "2" { "timeout" } else if name == "a" && rep == "3" { "holdout-tests" } else { "pass" }
    digest := corpus.fingerprint(sys.arg(0))
    row := corpus.Trial {
        task: name.clone(), harness: peer.clone(), trial: rep.clone(), model: competitors.MODEL, tree: tree.clone(),
        version: "fixture 1", fixture_sha256: corpus.fixture_digest(fixture), runner_sha256: digest.clone(), executable_sha256: digest.clone(),
        status: reason.clone(), tree_status: if reason == "timeout" { "pass" } else { reason.clone() }, turns_started: 1, turns_required: 1,
        budget_ms: 300000, elapsed_ms: if rep == "1" { i64(1000) } else if rep == "2" { i64(2000) } else { i64(3000) },
        manual_interventions: 0, exit_code: if reason == "timeout" { 124 } else if reason == "harness-error" { 1 } else { 0 }, signal: 0,
    }
    if quota && (peer == "pi" || peer == "goose") {
        stamp := clock.format_rfc3339(clock.unix_now().secs + 1)
        reset := if repeat { "2000-01-01 00:00:00" } else { text.replace(stamp[0..19], "T", " ") }
        msg := "Usage limit reached for 5 hour. Your limit will reset at " + reset
        log := if peer == "goose" { r#"{"type":"error","error":"# + json.quote("Ran into this error: Rate limit exceeded: [1308][" + msg + "]") + "}" } else {
            err := "429: " + r#"{"code":"1308","message":"# + json.quote(msg) + "}"
            r#"{"type":"agent_end","willRetry":false,"messages":[{"role":"assistant","stopReason":"error","errorMessage":"# + json.quote(err) + "}]}"
        }
        assert(sys.write(path.join(out, "turn-1.stdout"), log).is_ok())
    }
    assert(fs.write_private_text_atomic(path.join(out, "result.json"), json.to_string(&row).unwrap()).is_ok())
    if reason == "pass" { 0 } else { 1 }
}

fn run(exe: string, cwd: string, args: []string) -> process.Output {
    mut cmd := process.Command::new(exe.clone(), args.clone())
    cmd.set_cwd(cwd.clone())
    cmd.set_timeout(30000)
    cmd.exec()
}

fn output_sample(stdout: string, stderr: string, code: i32) -> process.Output {
    mut cmd := process.Command::new("/bin/sh", ["-c", r#"printf '%s\n' "$1"; printf '%s\n' "$2" >&2; exit "$3""#, "probe", stdout.clone(), stderr.clone(), code.str()])
    cmd.exec()
}

fn main() -> i32 {
    if sys.arg_count() == 6 { return fake_trial() }
    if sys.arg_count() == 2 && sys.arg(1) == "--version" { print("fixture 1"); return 0 }
    if sys.arg_count() != 2 { return 2 }
    app := fs.realpath(sys.arg(1)).value
    self_binary := fs.realpath(sys.arg(0)).value
    dir := fs.temp_dir("dunder-series-test-").value
    defer { _ := fs.remove_all(dir) }
    for name in ["a", "b"] {
        base := path.join(path.join(dir, "dogfood/cases"), name)
        assert(fs.mkdir_all(path.join(base, "start")).ok)
        assert(sys.write(path.join(base, "case.json"), "{}").is_ok())
        assert(sys.write(path.join(base, "start/file"), name.clone()).is_ok())
    }
    plan := r#"{"judge":"# + json.quote(self_binary) + r#","programs":[{"name":"dunder","executable":"# + json.quote(self_binary) + "}]}"
    assert(sys.write(path.join(dir, "plan.json"), plan).is_ok())
    args: []string = ["run", "report-dir", "plan.json"]
    seed := run(app, dir, ["run", "report-dir", "plan.json", "0"])
    assert(seed.succeeded() && text.contains(seed.stdout_text(), "dunder\t0\t0\t0\t0\t0\t6\t-\t0"))
    first := run(app, dir, args.clone())
    assert(!first.succeeded() && text.contains(first.stderr_text(), "Provider unavailable"))
    initial := path.join(dir, "report-dir/a/dunder-1/result.json")
    before := sys.read(initial).unwrap()
    finished := run(app, dir, args.clone())
    assert(finished.succeeded() && text.contains(finished.stdout_text(), "dunder\t1\t2\t2\t6\t0\t0\t2000\t0"))
    assert(sys.read(initial).unwrap() == before)
    assert(sys.metadata(path.join(dir, "report-dir/a/dunder-1/retry-1/result.json")).is_file)
    again := run(app, dir, args.clone())
    assert(again.succeeded() && again.stderr.len == 0)
    for peer in ["pi", "goose"] {
        file := peer + ".json"
        results := "results-" + peer
        assert(sys.write(path.join(dir, file), text.replace(plan, "\"name\":\"dunder\"", "\"name\":\"" + peer + "\"")).is_ok())
        paused := run(app, dir, ["run", results.clone(), file.clone(), "1"])
        assert(!paused.succeeded() && text.contains(paused.stderr_text(), "Provider unavailable"))
        base := path.join(path.join(dir, results), "a/" + peer + "-1")
        original := sys.read(path.join(base, "result.json")).unwrap()
        assert(!text.contains(original, "provider-error"))
        retried := run(app, dir, ["run", results.clone(), file.clone(), "1"])
        assert(retried.succeeded() && sys.metadata(path.join(base, "retry-1/result.json")).is_file)
        assert(sys.read(path.join(base, "result.json")).unwrap() == original)
    }
    waiting := run(app, dir, ["run", "waited", "pi.json", "1"])
    assert(!waiting.succeeded())
    pending := run(app, dir, ["report", "waited"])
    assert(pending.succeeded() && text.contains(pending.stdout_text(), "pi\t0\t0\t0\t0\t0\t5\t-\t0\t1"))
    original_quota := sys.read(path.join(dir, "waited/a/pi-1/result.json")).unwrap()
    watched := run(app, dir, ["watch", "waited", "pi.json", "+00:00", "1"])
    assert(watched.succeeded() && text.contains(watched.stderr_text(), "Waiting for quota until "))
    base := path.join(dir, "waited/a/pi-1")
    assert(sys.read(path.join(base, "result.json")).unwrap() == original_quota && sys.metadata(path.join(base, "retry-1/result.json")).is_file)
    assert(sys.write(path.join(dir, "repeat-limit"), "").is_ok())
    expired := run(app, dir, ["watch", "expired", "pi.json", "+00:00"])
    assert(!expired.succeeded() && text.contains(expired.stderr_text(), "repeated an expired quota reset"))
    assert(!sys.metadata(path.join(dir, "expired/a/pi-1/retry-2")).ok)
    assert(sys.remove_file(path.join(dir, "repeat-limit")).ok)
    unknown := run(app, dir, ["watch", "no-reset", "plan.json", "+08:00"])
    assert(!unknown.succeeded() && text.contains(unknown.stderr_text(), "without a verified quota reset"))
    assert(!sys.metadata(path.join(dir, "no-reset/a/dunder-1/retry-1")).ok)
    assert(sys.write(path.join(dir, "dogfood/cases/b/start/file"), "changed").is_ok())
    assert(!run(app, dir, args.clone()).succeeded())
    assert(sys.write(initial, text.replace(before, "fixture 1", "foreign version")).is_ok())
    assert(!run(app, dir, ["report", "report-dir"]).succeeded())
    err := r#"{"type":"error","error":{"data":{"statusCode":429}}}"#
    assert(competitors.provider_unavailable("kilo", &output_sample(err, "", 0)))
    assert(!competitors.provider_unavailable("opencode", &output_sample(err + "\n" + r#"{"type":"step_finish"}"#, "", 0)))
    quota := "Usage limit reached for 5 hour. Your limit will reset at 2000-01-01 10:00:00"
    goose := r#"{"type":"error","error":"Ran into this error: Rate limit exceeded: [1308]["# + quota + "]\"}"
    assert(competitors.provider_unavailable("goose", &output_sample(goose, "", 1)))
    assert(!competitors.provider_unavailable("goose", &output_sample(goose, "", 0)))
    assert(!competitors.provider_unavailable("goose", &output_sample(goose + "\n" + r#"{"type":"message"}"#, "", 1)))
    msg := r#"{"role":"assistant","stopReason":"error","errorMessage":"# + json.quote(r#"429: {"code":"1308","message":"# + json.quote(quota) + "}") + "}"
    terminal := r#"{"type":"agent_end","messages":["# + msg + "],\"willRetry\":false}"
    assert(competitors.provider_unavailable("pi", &output_sample(terminal + "\n" + r#"{"type":"agent_settled"}"#, "", 0)))
    assert(!competitors.provider_unavailable("pi", &output_sample(text.replace(terminal, "false", "true"), "", 0)))
    assert(!competitors.provider_unavailable("pi", &output_sample(text.replace(terminal, "assistant", "toolResult"), "", 0)))
    recovered := r#"{"type":"agent_end","messages":[{"role":"assistant","stopReason":"stop"}]}"#
    assert(!competitors.provider_unavailable("pi", &output_sample(terminal + "\n" + recovered, "", 0)))
    cline := r#"{"type":"run_result","finishReason":"error","text":"# + json.quote(quota) + "}"
    assert(competitors.provider_unavailable("cline", &output_sample(cline, "", 1)))
    assert(!competitors.provider_unavailable("cline", &output_sample(cline, "", 0)))
    assert(!competitors.provider_unavailable("cline", &output_sample(text.replace(cline, "\"error\"", "\"done\""), "", 1)))
    eight := quota_time.offset("+08:00").unwrap()
    assert(eight == 28800 && quota_time.offset("-03:30").unwrap() == -12600)
    for value in ["08:00", "+14:01", "+08:60", "+0x:00"] { assert(quota_time.offset(value).is_err()) }
    assert(quota_time.reset(quota, eight).unwrap() == 946692000)
    assert(quota_time.reset(text.replace(quota, "2000-01-01", "2023-02-29"), eight).is_none())
    assert(quota_time.reset(quota + "Z", eight).is_none() && quota_time.reset("temporary", eight).is_none())
    assert(competitors.dunder_failure("Session 1\nOpenCode connection failed (libcurl 28).\n") == "model-timeout")
    assert(competitors.dunder_failure("OpenCode model request timed out after 230 s.") == "model-timeout")
    assert(competitors.dunder_failure("OpenCode exceeded its 1 MiB output limit.") == "model-limit")
    assert(!competitors.provider_unavailable("dunder", &output_sample("", "OpenCode connection failed (libcurl 28).", 1)))
    assert(competitors.provider_unavailable("dunder", &output_sample("", "OpenCode HTTP 503 (service): unavailable", 1)))
    print("PASS frozen fixtures, immutable retries, three repetitions, median, independent tree grading, mismatched receipts, provider errors, quota wait and retry")
    0
}
