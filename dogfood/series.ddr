capability filesystem, process, stdio, unsafe
import .corpus
import .competitors
import .quota
import std.cmp as cmp
import std.time as clock
import std.array as array
import std.fs as fs
import std.json as json
import std.parse as parse
import std.path as path
import std.process as process
import std.text as text
import sys

@extern("c", "flock")
unsafe fn flock(fd: i32, operation: i32) -> i32

@derive(Decode)
struct Program { name: string, executable: string }

@derive(Decode)
struct Plan { judge: string, programs: []Program }

@derive(Encode, Decode)
struct Participant { name: string, exe: string, version: string, digest: string }

@derive(Encode, Decode)
struct Fixture { name: string, digest: string, tree: string }

@derive(Encode, Decode)
struct Campaign {
    model: string, budget_ms: i64, repetitions: i32,
    judge: string, judge_digest: string, programs: []Participant, fixtures: []Fixture,
}

const REQUIRED_WINS: i32 = 3
const BUDGET_MS: i64 = 300000

fn harnesses() -> []string { ["dunder", "opencode", "pi", "goose", "cline", "kilo"] }

fn resolve(name: string) -> Result<string, string> {
    resolved := if text.contains(name, "/") { name.clone() } else { text.trim(process.run("which", [name.clone()]).stdout_text()) }
    abs := fs.realpath(resolved)
    if !abs.ok || !sys.metadata(abs.value).is_file { return .Err("Executable unavailable: " + name) }
    .Ok(abs.value)
}

fn freeze(file: string) -> Result<Campaign, string> {
    raw := sys.read_limit(file, 65536).ok().ok_or("Could not read plan.")?
    plan := json.from_str<Plan>(raw).ok().ok_or("Expected a judge and a list of programs.")?
    judge := resolve(plan.judge)?
    mut programs: []Participant = []
    mut names: []string = []
    supported := harnesses()
    for program in &plan.programs {
        if !array.contains(&supported, program.name) || array.contains(&names, program.name) {
            return .Err("Invalid or duplicate harness: " + program.name)
        }
        exe := resolve(program.executable)?
        identity := corpus.call(".", [exe.clone(), "--version"])
        if !identity.succeeded() { return .Err("Could not check version: " + program.name) }
        names.push(program.name.clone())
        programs.push(Participant { name: program.name.clone(), exe: exe.clone(), version: text.trim(identity.stdout_text()), digest: corpus.fingerprint(exe) })
    }
    if programs.len == 0 { return .Err("No harnesses in plan.") }
    temp := fs.temp_dir("series-seeds-")
    if !temp.ok { return .Err("Could not allocate a fixture directory.") }
    defer { _ := fs.remove_all(temp.value) }
    mut fixtures: []Fixture = []
    mut cases := fs.list_dir("dogfood/cases").ok().ok_or("Run from the repository root.")?
    array.sort(&mut cases)
    for name in &cases {
        dir := path.join("dogfood/cases", name)
        if sys.metadata(path.join(dir, "case.json")).is_file {
            fixtures.push(Fixture { name: name.clone(), digest: corpus.fixture_digest(dir), tree: corpus.seed(dir, path.join(temp.value, name)) })
        }
    }
    if fixtures.len == 0 { return .Err("No fixtures found.") }
    .Ok(Campaign { model: competitors.MODEL, budget_ms: BUDGET_MS, repetitions: 3, judge: judge.clone(), judge_digest: corpus.fingerprint(judge), programs: move programs, fixtures: move fixtures })
}

fn slot(root: string, fixture: &Fixture, peer: &Participant, rep: i32) -> string {
    path.join(path.join(root, fixture.name), peer.name + "-" + rep.str())
}

fn receipt(folder: string, cfg: &Campaign, fixture: &Fixture, peer: &Participant, rep: i32) -> Result<corpus.Trial, string> {
    file := path.join(folder, "result.json")
    raw := sys.read_limit(file, 32768).ok().ok_or("Missing receipt: " + file)?
    mut row := json.from_str<corpus.Trial>(raw).ok().ok_or("Invalid receipt: " + file)?
    if row.task != fixture.name || row.harness != peer.name || row.trial != rep.str() || row.model != cfg.model ||
    row.version != peer.version || row.fixture_sha256 != fixture.digest || row.executable_sha256 != peer.digest ||
    row.runner_sha256 != cfg.judge_digest || row.budget_ms != cfg.budget_ms || row.elapsed_ms < 0 ||
    row.manual_interventions < 0 || row.tree != fixture.tree || row.turns_started < 1 || row.turns_required < row.turns_started { return .Err("Receipt does not match frozen configuration: " + file) }
    if row.harness == "dunder" && (row.status == "provider-error" || row.status == "harness-error") {
        stderr := sys.read_text_limit(path.join(folder, "turn-" + row.turns_started.str() + ".stderr"), 1048576)
        if stderr.ok {
            reason := competitors.dunder_failure(stderr.value)
            if reason != "" { row.status = reason.clone() }
        }
    }
    if (row.harness == "pi" || row.harness == "goose" || row.harness == "cline") && row.status != "timeout" && row.status != "provider-error" {
        stdout := sys.read_text_limit(path.join(folder, "turn-" + row.turns_started.str() + ".stdout"), 67108864)
        if stdout.ok && quota.message(row.harness, stdout.value, row.exit_code) != "" { row.status = "provider-error" }
    }
    if row.status == "pass" && (row.tree_status != "pass" || row.turns_started != row.turns_required ||
    row.elapsed_ms >= row.budget_ms || row.exit_code != 0 || row.signal != 0) {
        return .Err("Passing receipt contradicts its check, completion or deadline: " + file)
    }
    .Ok(row)
}

fn attempt(base: string, cfg: &Campaign, fixture: &Fixture, peer: &Participant, rep: i32, retry: bool) -> Result<string, string> {
    mut folder := base.clone()
    mut i := 0
    while sys.metadata(path.join(folder, "result.json")).is_file {
        row := receipt(folder, &cfg, &fixture, &peer, rep)?
        if row.status != "provider-error" { break }
        i += 1
        next := path.join(base, "retry-" + i.str())
        if !retry && !sys.metadata(path.join(next, "result.json")).is_file { break }
        folder = move next
    }
    .Ok(folder)
}

fn scored(status: string) -> bool {
    values: []string = ["pass", "timeout", "model-timeout", "decision-limit", "model-limit", "task-incomplete", "missing-final-check", "missing-first-check", "public-tests", "holdout-tests", "protected-file", "invalid-tree", "oracle-file-collision", "resume-unavailable"]
    array.contains(&values, status)
}

struct Score {
    solved: i32, trees: i32, fully: i32, scored: i32, review: i32, missing: i32,
    provider: i32, manual: i32, median: string,
}

fn score(cfg: &Campaign, root: string, peer: &Participant) -> Result<Score, string> {
    mut solved := 0
    mut tree_solved := 0
    mut fully := 0
    mut review := 0
    mut provider := 0
    mut missing := 0
    mut manual := 0
    mut times: []i64 = []
    for fixture in &cfg.fixtures {
        mut passed := 0
        mut passing_trees := 0
        mut decisions := 0
        for r in 1..(cfg.repetitions + 1) {
            folder := attempt(slot(root, &fixture, &peer, r), &cfg, &fixture, &peer, r, false)?
            if !sys.metadata(path.join(folder, "result.json")).is_file { missing += 1; continue }
            row := receipt(folder, &cfg, &fixture, &peer, r)?
            if row.status == "provider-error" { provider += 1; continue }
            if !scored(row.status) { review += 1; continue }
            if row.tree_status == "pass" && row.turns_started == row.turns_required { passing_trees += 1 }
            decisions += 1
            if row.status == "pass" { passed += 1 }
            times.push(row.elapsed_ms)
            manual += row.manual_interventions
        }
        if passing_trees >= 2 { tree_solved += 1 }
        if passed >= 2 { solved += 1 }
        if decisions == cfg.repetitions { fully += 1 }
    }
    array.sort(&mut times)
    mut median := "-"
    if times.len > 0 {
        lower := times[(times.len - 1) / 2]
        median = (lower + (times[times.len / 2] - lower) / 2).str()
    }
    .Ok(Score { solved: solved, trees: tree_solved, fully: fully, scored: times.len, review: review, missing: missing, provider: provider, manual: manual, median: move median })
}

fn report(cfg: &Campaign, root: string) -> Result<(), string> {
    print("harness\tsolved\ttree-verified\tfully-tested\tscored\treview\tmissing\tmedian-ms\tmanual\tprovider")
    for peer in &cfg.programs {
        s := score(&cfg, root, &peer)?
        print(f"{peer.name}\t{s.solved}\t{s.trees}\t{s.fully}\t{s.scored}\t{s.review}\t{s.missing}\t{s.median}\t{s.manual}\t{s.provider}")
    }
    .Ok
}

@derive(Encode, Decode)
struct Standing { harness: string, version: string, solved: i32 }

@derive(Encode, Decode)
struct Verdict {
    status: string, candidate: string, model: string, tasks: i32, total: i32,
    scored: i32, missing: i32, review: i32, provider: i32, required_wins: i32,
    wins: Option<i32>, standings: []Standing,
}

fn verdict(cfg: &Campaign, root: string, candidate_root: string) -> Result<(), string> {
    if cfg.model != competitors.MODEL || cfg.budget_ms != BUDGET_MS { return .Err("The goal requires " + competitors.MODEL + " and a five-minute deadline.") }
    mut names: []string = []
    for p in &cfg.programs { names.push(p.name.clone()) }
    mut expected := harnesses()
    array.sort(&mut expected)
    array.sort(&mut names)
    if names != expected { return .Err("The goal requires Dunder, OpenCode, Pi, Goose, Cline and Kilo.") }
    mut tasks: []string = []
    mut digests: []string = []
    for fixture in &cfg.fixtures {
        if array.contains(&tasks, fixture.name) || array.contains(&digests, fixture.digest) { return .Err("Repeated task in frozen campaign: " + fixture.name) }
        tasks.push(fixture.name.clone())
        digests.push(fixture.digest.clone())
    }
    if tasks.len < 12 || cfg.repetitions != 3 { return .Err("The goal requires at least twelve distinct tasks and three trials per task.") }
    mut result := Verdict { status: "pending", candidate: "", model: cfg.model.clone(), tasks: tasks.len, total: tasks.len * cfg.repetitions * names.len, scored: 0, missing: 0, review: 0, provider: 0, required_wins: REQUIRED_WINS, wins: .None, standings: [] }
    mut standings: []Standing = []
    mut solved := 0
    for peer in &cfg.programs {
        receipts := if peer.name == "dunder" { candidate_root.clone() } else { root.clone() }
        s := score(&cfg, receipts, &peer)?
        result.scored += s.scored
        result.missing += s.missing
        result.review += s.review
        result.provider += s.provider
        if peer.name == "dunder" { solved = s.solved; result.candidate = peer.version.clone() }
        standings.push(Standing { harness: peer.name.clone(), version: peer.version.clone(), solved: s.solved })
    }
    if result.scored == result.total {
        mut wins := 0
        for row in &standings { if row.solved < solved { wins += 1 } }
        result.status = if wins >= REQUIRED_WINS { "met" } else { "not-met" }
        result.wins = .Some(wins)
        result.standings = move standings
    }
    print(json.to_string(&result).unwrap())
    .Ok
}

fn reset_for(folder: string, row: &corpus.Trial, zone: i64) -> Result<i64, string> {
    ext := if row.harness == "dunder" { ".stderr" } else { ".stdout" }
    file := path.join(folder, "turn-" + row.turns_started.str() + ext)
    log := sys.read_text_limit(file, 67108864)
    if log.ok {
        msg := quota.message(row.harness, log.value, row.exit_code)
        match quota.reset(msg, zone) { .Some(t) => { return .Ok(t) }, .None => {}, }
    }
    .Err("Provider unavailable without a verified quota reset at " + folder)
}

fn series(cfg: &Campaign, root: string, limit: i32, zone: Option<i64>) -> Result<(), string> {
    mut added := 0
    for rep in 1..(cfg.repetitions + 1) {
        for n in 0..cfg.fixtures.len {
            fixture := &cfg.fixtures[(n + rep - 1) % cfg.fixtures.len]
            for i in 0..cfg.programs.len {
                peer := &cfg.programs[(i + n + rep - 1) % cfg.programs.len]
                base := slot(root, &fixture, &peer, rep)
                mut folder := attempt(base, &cfg, &fixture, &peer, rep, false)?
                mut last_reset := i64(-1)
                while true {
                    fresh := !sys.metadata(path.join(folder, "result.json")).is_file
                    if fresh {
                        if added >= limit { return .Ok }
                        if sys.metadata(folder).ok { return .Err("Open or interrupted attempt: " + folder) }
                        _ := sys.eprint(f"{fixture.name} / {peer.name} / {rep}")
                        mut trial := process.Command::new(cfg.judge.clone(), [fixture.name.clone(), peer.name.clone(), peer.exe.clone(), rep.str(), folder.clone()])
                        trial.inherit_stdio()
                        _ := trial.exec()
                        added += 1
                    }
                    row := receipt(folder, &cfg, &fixture, &peer, rep)?
                    if row.status != "provider-error" { break }
                    if zone.is_some() {
                        if added >= limit { return .Ok }
                        reset := reset_for(folder, &row, zone.unwrap())?
                        if reset <= last_reset { return .Err("Provider repeated an expired quota reset at " + folder) }
                        last_reset = reset
                        ready := reset + 3
                        if ready > clock.unix_now().secs { _ := sys.eprint("Waiting for quota until " + clock.format_rfc3339(ready) + " at " + folder) }
                        while true {
                            left := ready - clock.unix_now().secs
                            if left <= 0 { break }
                            sys.sleep_ms(cmp.min<i64>(60, left) * 1000)
                        }
                    } else if fresh { return .Err("Provider unavailable at " + folder + ". Resume to retain this receipt and retry.") }
                    folder = attempt(base, &cfg, &fixture, &peer, rep, true)?
                }
            }
        }
    }
    .Ok
}

fn load_campaign(root: string) -> Result<Campaign, string> {
    raw := sys.read_limit(path.join(root, "campaign.json"), 1048576).ok().ok_or("Missing campaign in " + root)?
    json.from_str<Campaign>(raw).ok().ok_or("Invalid campaign in " + root)
}

fn candidate_verdict(root: string, candidate_root: string) -> Result<(), string> {
    mut cfg := load_campaign(root)?
    candidate := load_campaign(candidate_root)?
    if candidate.programs.len != 1 || candidate.programs[0].name != "dunder" { return .Err("The candidate campaign must contain only Dunder.") }
    if cfg.model != candidate.model || cfg.budget_ms != candidate.budget_ms || cfg.repetitions != candidate.repetitions ||
    cfg.judge_digest != candidate.judge_digest || json.to_string(&cfg.fixtures).unwrap() != json.to_string(&candidate.fixtures).unwrap() {
        return .Err("Candidate and baseline must match on model, deadline, repetitions, judge and frozen fixtures.")
    }
    for i in 0..cfg.programs.len {
        if cfg.programs[i].name == "dunder" { cfg.programs[i] = candidate.programs[0].clone() }
    }
    verdict(&cfg, root, candidate_root)
}

fn drive() -> Result<(), string> {
    if sys.arg_count() < 3 { return .Err("series report OUT | series verdict OUT [DUNDER-CAMPAIGN] | series run OUT PLAN [MAX-NEW] | series watch OUT PLAN PROVIDER-OFFSET [MAX-NEW]") }
    root := sys.arg(2)
    file := path.join(root, "campaign.json")
    if sys.arg(1) == "report" || sys.arg(1) == "verdict" {
        if sys.arg(1) == "verdict" && sys.arg_count() == 4 { return candidate_verdict(root, sys.arg(3)) }
        if sys.arg_count() != 3 { return .Err("series report OUT | series verdict OUT [DUNDER-CAMPAIGN]") }
        cfg := load_campaign(root)?
        if sys.arg(1) == "verdict" { return verdict(&cfg, root, root) }
        return report(&cfg, root)
    }
    watch := sys.arg(1) == "watch"
    required := if watch { 5 } else { 4 }
    if (!watch && sys.arg(1) != "run") || sys.arg_count() < required || sys.arg_count() > required + 1 {
        return .Err("series run OUT PLAN [MAX-NEW] | series watch OUT PLAN PROVIDER-OFFSET [MAX-NEW]")
    }
    mut zone: Option<i64> = .None
    if watch { zone = .Some(quota.offset(sys.arg(4))?) }
    mut limit := 2147483647
    if sys.arg_count() == required + 1 {
        value := sys.arg(required)
        parsed := parse.i64_range(value, 0, value.len)
        if !parsed.ok || parsed.value < 0 || parsed.value > 2147483647 { return .Err("Invalid attempt count.") }
        limit = i32(parsed.value)
    }
    if !fs.mkdir_all(root).ok { return .Err("Could not create results directory.") }
    mut opts := fs.OpenOptions::read_write()
    opts.set_create(true)
    opts.set_mode(384)
    mut guard := fs.File::open(path.join(root, "series.lock"), opts).ok().ok_or("Could not lock campaign.")?
    unsafe { if flock(guard.fd(), 6) != 0 { return .Err("Campaign already running.") } }
    cfg := freeze(sys.arg(3))?
    encoded := json.to_string(&cfg).unwrap()
    if sys.metadata(file).is_file {
        if sys.read(file).ok().ok_or("Could not read campaign.")? != encoded { return .Err("Configuration changed. Use a new campaign directory.") }
    } else {
        if fs.write_private_text_atomic(file, encoded).is_err() { return .Err("Could not save campaign.") }
    }
    series(&cfg, root, limit, zone)?
    report(&cfg, root)
}

fn main() -> i32 {
    match drive() { .Ok => 0, .Err(e) => { _ := sys.eprint(e); 1 }, }
}
