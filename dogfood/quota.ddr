import std.json as json
import std.parse as parse
import std.text as text
import std.time as clock

const USAGE: string = "Usage limit reached for "

fn pi_message(doc: &json.Doc) -> string {
    if doc.get_bool(doc.root, "willRetry").unwrap_or(false) { return "" }
    messages := doc.field(doc.root, "messages")
    if doc.count(messages) == 0 { return "" }
    last := doc.at(messages, doc.count(messages) - 1)
    if doc.get_str(last, "role").unwrap_or_default() != "assistant" || doc.get_str(last, "stopReason").unwrap_or_default() != "error" { return "" }
    err := doc.get_str(last, "errorMessage").unwrap_or_default()
    if !text.starts_with(err, "429: ") { return "" }
    data := json.Doc::parse_text(err[5..err.len])
    if data.get_str(data.root, "code").unwrap_or_default() != "1308" { return "" }
    msg := data.get_str(data.root, "message").unwrap_or_default()
    if text.starts_with(msg, USAGE) { msg } else { "" }
}

pub fn message(peer: string, log: string, code: i32) -> string {
    if !text.contains(log, USAGE) { return "" }
    lines := text.split(text.trim(log), "\n")
    if peer == "dunder" {
        last := &lines[lines.len - 1]
        if code != 0 && text.starts_with(last, "OpenCode HTTP ") && text.contains(last, " (rate_limit): " + USAGE) { return last.clone() }
        return ""
    }
    if (peer == "goose" || peer == "cline") && code == 0 { return "" }
    mut i := lines.len
    while i > 0 {
        i -= 1
        line := &lines[i]
        if peer == "pi" && !text.contains(line, "\"agent_end\"") { continue }
        doc := json.Doc::parse_text(line)
        kind := doc.get_str(doc.root, "type").unwrap_or_default()
        if peer == "cline" && kind == "run_result" {
            msg := doc.get_str(doc.root, "text").unwrap_or_default()
            if doc.get_str(doc.root, "finishReason").unwrap_or_default() == "error" && text.starts_with(msg, USAGE) { return msg }
            return ""
        }
        if peer == "pi" && kind == "agent_end" { return pi_message(&doc) }
        if peer == "goose" && kind != "" {
            err := doc.get_str(doc.root, "error").unwrap_or_default()
            if kind == "error" && text.starts_with(err, "Ran into this error: Rate limit exceeded: [1308][" + USAGE) { return err }
            return ""
        }
        if peer == "opencode" || peer == "kilo" {
            if kind == "step_finish" { return "" }
            if kind != "error" { continue }
            data := doc.field(doc.field(doc.root, "error"), "data")
            msg := doc.get_str(data, "message").unwrap_or_default()
            if doc.get_i64(data, "statusCode").unwrap_or(0) == 429 && text.starts_with(msg, USAGE) { return msg }
            return ""
        }
    }
    ""
}

fn digits(value: string, start: i32, end: i32) -> i32 {
    for i in start..end { if value[i] < b'0' || value[i] > b'9' { return -1 } }
    i32(parse.i64_range(value, start, end).value)
}

pub fn offset(zone: string) -> Result<i64, string> {
    err := "Expected the provider clock offset, for example +08:00."
    if zone.len != 6 || (zone[0] != b'+' && zone[0] != b'-') || zone[3] != b':' { return .Err(err) }
    hours := digits(zone, 1, 3)
    minutes := digits(zone, 4, 6)
    if hours < 0 || hours > 14 || minutes < 0 || minutes > 59 || (hours == 14 && minutes != 0) { return .Err(err) }
    seconds := i64(hours * 3600 + minutes * 60)
    .Ok(if zone[0] == b'-' { -seconds } else { seconds })
}

pub fn reset(msg: string, zone: i64) -> Option<i64> {
    prefix := ". Your limit will reset at "
    start := text.find(msg, prefix)? + prefix.len
    if msg.len - start < 19 { return .None }
    for i in 0..19 {
        c := msg[start + i]
        expected := match i { 4 | 7 => b'-', 10 => b' ', 13 | 16 => b':', _ => u8(0), }
        if expected == 0 { if c < b'0' || c > b'9' { return .None } }
        else if c != expected { return .None }
    }
    end := start + 19
    if end < msg.len && msg[end] != b']' { return .None }
    stamp := msg[start..end]
    dt := clock.DateTime { year: digits(stamp, 0, 4), month: digits(stamp, 5, 7), day: digits(stamp, 8, 10), hour: digits(stamp, 11, 13), minute: digits(stamp, 14, 16), second: digits(stamp, 17, 19), weekday: 0 }
    if dt.year < 1970 || dt.month < 1 || dt.month > 12 || dt.day < 1 || dt.day > 31 || dt.hour > 23 || dt.minute > 59 || dt.second > 59 { return .None }
    wall := clock.unix_from_utc(&dt)
    if clock.format_rfc3339(wall) != text.replace(stamp, " ", "T") + "Z" { return .None }
    .Some(wall - zone)
}
