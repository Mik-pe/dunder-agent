capability filesystem, process, stdio
import std.array as array
import std.bytes as bytes
import std.json as json
import std.process as process
import std.text as text
import std.time as clock
import .output
import .provider
import .reference
import .session
import .workspace
import sys

pub const MAX_TASK_BYTES: i64 = 32768
pub const TASK_TOO_LARGE: string = "Task exceeds 32 KiB."

pub enum Phase { Idle, Model, Command, Check, Approval }
pub struct Run {
    references: []reference.Reference, history: session.Session, file: string, scratch: string, model: string, model_timeout_s: i64, check: string, root_entries: string,
    interactive: bool, dunder_skill: bool, phase: Phase, child: []process.Child,
    stdout: output.Stream, stderr: output.Stream, since: i64, steps: i32, max_steps: i32,
    needs_check: bool, bad_check: bool, corrections: i32, pending: string, status: string, failed: bool,
}

pub fn safe(s: string) -> string {
    mut out: []u8 = []
    for c in s.runes() {
        n := i32(c)
        if n == 10 || n == 9 || (n >= 32 && (n < 127 || n > 159)) {
            bytes.append_utf8(&mut out, c.str())
        }
    }
    bytes.decode(&out).unwrap_or_default()
}

pub fn label(action: &json.Doc) -> string {
    name := action.get_str(action.root, "tool").unwrap_or("?")
    ref := action.get_str(action.root, "reference").unwrap_or_default()
    label := if ref == "" { name.clone() } else { name + " [" + ref + "]" }
    if name == "read_many" {
        nodes := action.field(action.root, "paths")
        mut names: []string = []
        for i in 0..action.count(nodes) {
            if i >= 8 { break }
            names.push(action.as_str(action.at(nodes, i)).unwrap_or("?"))
        }
        return label + " " + workspace.clip(array.join(&names, ", "), 240)
    }
    detail := action.get_str(action.root, "path").unwrap_or(action.get_str(action.root, "query").unwrap_or(action.get_str(action.root, "command").unwrap_or_default()))
    if detail == "" { return label }
    label + " " + detail
}

pub fn event(run: &mut Run, kind: string, body: string) -> Result<(), string> {
    session.record(&mut run.history, run.file, kind, body)?
    .Ok
}

fn start_child(run: &mut Run, move child: process.Child, phase: Phase, status: string) {
    assert(run.child.len == 0)
    run.child.push(move child)
    run.stdout = output.Stream::new()
    run.stderr = output.Stream::new()
    run.phase = phase
    run.since = clock.monotonic_ms()
    run.status = status.clone()
}

fn request(run: &mut Run) -> Result<(), string> {
    if run.steps >= run.max_steps { return .Err(f"Turn stopped at the {run.max_steps}-decision limit.") }
    child := provider.launch(run.scratch, run.model, run.model_timeout_s, run.check, run.root_entries, &run.references, run.interactive, run.dunder_skill, &run.history)?
    run.steps += 1
    start_child(&mut run, move child, .Model, f"Thinking · {run.steps}/{run.max_steps}")
    .Ok
}

pub fn validate_task(message: string) -> Result<(), string> {
    if i64(message.len) > MAX_TASK_BYTES { return .Err(TASK_TOO_LARGE) }
    if text.trim(message) == "" { return .Err("Enter a task.") }
    .Ok
}

pub fn submit(run: &mut Run, message: string) -> Result<(), string> {
    if run.phase != .Idle { return .Err("A turn is already running.") }
    validate_task(message)?
    run.failed = false
    run.steps = 0
    run.corrections = 0
    run.needs_check = run.check != "" && session.requires_check(&run.history)
    run.bad_check = false
    entries := workspace.listing(run.history.root).unwrap_or_default()
    run.dunder_skill = run.dunder_skill || provider.uses_dunder(entries, &run.history)
    run.root_entries = workspace.clip(entries, 2048)
    event(&mut run, "user", message)?
    request(&mut run)
}

fn result(run: &mut Run, move outcome: Result<string, string>) -> Result<(), string> {
    body := match outcome { .Ok(value) => value, .Err(msg) => "Error: " + msg, }
    event(&mut run, "result", body)?
    request(&mut run)
}

fn shell(run: &mut Run, command: string, phase: Phase) -> Result<(), string> {
    mut cmd := process.Command::new("/bin/sh", ["-c", command.clone()])
    cmd.set_cwd(run.history.root.clone())
    cmd.set_env("PWD", run.history.root.clone())
    match cmd.spawn() {
        .Ok(child) => { start_child(&mut run, move child, phase, "Running local command"); .Ok },
        .Err(e) => {
            if phase == .Check { run.bad_check = true; run.needs_check = false }
            result(&mut run, .Err(e.message()))
        },
    }
}

pub fn approve(run: &mut Run, allow: bool) -> Result<(), string> {
    if run.phase != .Approval { return .Err("No command is waiting for approval.") }
    if !allow { return result(&mut run, .Err("Command declined by user.")) }
    command := run.pending.clone()
    shell(&mut run, command, .Command)
}

fn check(run: &mut Run) -> Result<(), string> {
    event(&mut run, "action", r#"{"tool":"check"}"#)?
    line := run.check.clone()
    shell(&mut run, line, .Check)
}

fn write_files(run: &mut Run, action: &json.Doc, raw: string, group: bool) -> Result<(), string> {
    actions := if group {
        match workspace.edit_plan(run.history.root, &action) {
            .Ok(ops) => ops,
            .Err(reason) => {
                event(&mut run, "action", raw)?
                return result(&mut run, .Err(reason))
            },
        }
    } else { [raw.clone()] }
    for op in &actions {
        event(&mut run, "action", op)?
        item := json.Doc::parse_text(op)
        run.dunder_skill = run.dunder_skill || provider.dunder_action(&item)
        match workspace.execute(run.history.root, &item) {
            .Ok(saved) => { run.needs_check = true; event(&mut run, "result", saved)? },
            .Err(reason) => { return result(&mut run, .Err(reason)) },
        }
    }
    if run.check != "" && action.get_bool(action.root, "check").unwrap_or(false) { return check(&mut run) }
    request(&mut run)
}

fn act(run: &mut Run, raw: string) -> Result<(), string> {
    action := json.Doc::parse_text(raw)
    run.dunder_skill = run.dunder_skill || provider.dunder_action(&action)
    tool := action.get_str(action.root, "tool").unwrap_or_default()
    if action.field(action.root, "reference") >= 0 {
        event(&mut run, "action", raw)?
        return result(&mut run, reference.inspect(&run.references, &action))
    }
    if tool == "finish" {
        answer := action.get_str(action.root, "answer").unwrap_or_default()
        if text.trim(answer) == "" { return result(&mut run, .Err("A finish action needs a nonempty answer.")) }
        if run.needs_check && run.check != "" { return check(&mut run) }
        event(&mut run, "assistant", answer)?
        run.phase = .Idle
        blocked := action.get_bool(action.root, "blocked").unwrap_or(false)
        run.failed = run.bad_check || blocked
        run.status = if run.bad_check { "Local check failed" } else if blocked { "Task blocked" } else { "Ready" }
        return .Ok
    }
    if tool == "edit" || tool == "create" || tool == "edit_many" {
        return write_files(&mut run, &action, raw, tool == "edit_many")
    }
    event(&mut run, "action", raw)?
    if tool == "shell" {
        line := action.get_str(action.root, "command").unwrap_or_default()
        if !run.interactive { return result(&mut run, .Err("Shell requires the interactive TUI.")) }
        if line == "" || line.len > 4096 || safe(line) != line { return result(&mut run, .Err("Invalid shell command.")) }
        run.phase = .Approval
        run.pending = line
        run.status = "Run this command?   y allow   n decline"
        return .Ok
    }
    if tool == "check" {
        if run.check == "" { return result(&mut run, .Err("No local check configured.")) }
        line := run.check.clone()
        return shell(&mut run, line, .Check)
    }
    result(&mut run, workspace.execute(run.history.root, &action))
}

fn stop_child(run: &mut Run) {
    if run.child.len == 0 { return }
    _ := run.child[0].kill()
    _ := run.child[0].wait(1000)
    run.child.clear()
}

pub fn cancel(run: &mut Run) -> Result<(), string> {
    if run.phase == .Idle { return .Ok }
    stop_child(&mut run)
    run.phase = .Idle
    run.failed = true
    run.status = "Cancelled"
    event(&mut run, "notice", "Turn cancelled. Inspect files before continuing interrupted work.")
}

pub fn stop(run: &mut Run, reason: string) {
    stop_child(&mut run)
    run.phase = .Idle
    run.failed = true
    run.status = reason.clone()
    match event(&mut run, "notice", reason) {
        .Ok => {},
        .Err(e) => { run.status += " / " + e; _ := sys.eprint(safe(run.status)) },
    }
}

fn read_pipe(child: &mut process.Child, stream: &mut output.Stream, stderr: bool, compact: bool) -> Result<i64, string> {
    chunk := if stderr { child.read_stderr(&mut stream.data, 65536, 0) } else { child.read_stdout(&mut stream.data, 65536, 0) }
    match chunk {
        .Ok(n) => { if n > 0 { stream.received(n, compact) }; .Ok(n) },
        .Err(e) => { if e.is_would_block() { return .Ok(0) }; .Err(e.message()) },
    }
}

pub fn poll(run: &mut Run) -> Result<bool, string> {
    if run.phase != .Model && run.phase != .Command && run.phase != .Check { return .Ok(false) }
    model := run.phase == .Model
    waited := run.child[0].try_wait()
    if !waited.ok { return .Err("Could not wait for child process.") }
    mut draining := false
    mut consumed := false
    for _ in 0..8 {
        a := read_pipe(&mut run.child[0], &mut run.stdout, false, !model)?
        b := read_pipe(&mut run.child[0], &mut run.stderr, true, !model)?
        draining = a + b > 0
        if model && run.stdout.total + run.stderr.total > 1048576 { return .Err("OpenCode exceeded its 1 MiB output limit.") }
        if !draining { break }
        consumed = true
    }
    limit := if model { run.model_timeout_s * 1000 + 1000 } else { i64(60000) }
    if (!waited.exited || draining) && clock.monotonic_ms() - run.since >= limit {
        stop_child(&mut run)
        if model { return .Err(provider.timed_out(run.model_timeout_s)) }
        run.needs_check = run.phase == .Command
        if run.phase == .Check { run.bad_check = true }
        message := output.report("Error: " + output.TIMEOUT, &run.stdout, &run.stderr)
        result(&mut run, .Ok(message))?
        return .Ok(true)
    }
    if !waited.exited || draining { return .Ok(consumed) }
    _ := run.child[0].wait(1000)
    run.child.clear()
    if !model {
        if run.phase == .Check {
            run.needs_check = false
            run.bad_check = waited.code != 0 || waited.signal != 0
        } else { run.needs_check = true }
        report := output.report(f"exit {waited.code}, signal {waited.signal}", &run.stdout, &run.stderr)
        result(&mut run, .Ok(report))?
    } else {
        if waited.code != 0 || waited.signal != 0 {
            detail := text.trim(bytes.decode(&run.stderr.data).unwrap_or_default())
            if detail == "" { return .Err(f"Model worker exited with code {waited.code}, signal {waited.signal}.") }
            return .Err(workspace.clip(detail, 700))
        }
        match provider.decision(bytes.decode(&run.stdout.data).unwrap_or_default()) {
            .Ok(raw) => { run.corrections = 0; act(&mut run, raw)? },
            .Err(e) => {
                if e == "Expected a JSON decision with a tool name." && run.corrections == 0 {
                    run.corrections += 1
                    event(&mut run, "notice", "The last reply was malformed. Return exactly one JSON action.")?
                    request(&mut run)?
                } else { return .Err(e) }
            },
        }
    }
    .Ok(true)
}
