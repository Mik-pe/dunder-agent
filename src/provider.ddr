capability filesystem, process, network, stdio
import http_client
import std.base64 as base64
import std.bytes as bytes
import std.cmp as cmp
import std.fs as fs
import std.json as json
import std.path as path
import std.parse as parse
import std.process as process
import std.text as text
import std.time as clock
import .reference
import .session
import .workspace
import sys

const CONTRACT: string = @embed_file("src/contract.txt")
pub const DUNDER_SKILL: string = @embed_file(".agents/skills/dunder/SKILL.md")
const MODEL_FORMAT: string = "Expected provider/model or provider/model#variant."
pub const DEFAULT_TIMEOUT: i64 = 140
pub const MODEL: string = "zai-coding-plan/glm-5.4"

pub fn model_ref(model: string) -> Result<string, string> {
    slash := text.find(model, "/").ok_or(MODEL_FORMAT)?
    provider := model[0..slash]
    if provider == "" || text.contains(provider, "#") { return .Err(MODEL_FORMAT) }
    rest := model[slash + 1..model.len]
    parts := text.split(rest, "#")
    if parts.len == 0 || parts.len > 2 || parts[0] == "" || (parts.len == 2 && parts[1] == "") { return .Err(MODEL_FORMAT) }
    mut encoded := r#"{"providerID":"# + json.quote(provider) + r#","id":"# + json.quote(parts[0])
    if parts.len == 2 { encoded += r#","variant":"# + json.quote(parts[1]) }
    .Ok(encoded + "}")
}

pub fn timeout_seconds(arg: string) -> Result<i64, string> {
    parsed := parse.i64_range(arg, 0, arg.len)
    if !parsed.ok || parsed.value < 1 || parsed.value > 2147483647 { return .Err("Expected a positive model timeout in seconds (up to 2147483647).") }
    .Ok(parsed.value)
}

pub fn timed_out(seconds: i64) -> string {
    f"OpenCode model request timed out after {seconds} s."
}

fn dunder_file(name: string) -> bool {
    text.ends_with(name, ".ddr") || path.basename(name) == "dunder.toml"
}

pub fn dunder_action(action: &json.Doc) -> bool {
    if action.field(action.root, "reference") >= 0 { return false }
    tool := action.get_str(action.root, "tool").unwrap_or_default()
    if tool == "read" || tool == "edit" || tool == "create" {
        return dunder_file(action.get_str(action.root, "path").unwrap_or_default())
    }
    if tool == "read_many" {
        paths := action.field(action.root, "paths")
        for i in 0..action.count(paths) {
            if dunder_file(action.as_str(action.at(paths, i)).unwrap_or_default()) { return true }
        }
    }
    false
}

pub fn uses_dunder(root_entries: string, state: &session.Session) -> bool {
    for name in text.split(root_entries, "\n") {
        if !text.ends_with(name, "/") && dunder_file(name) { return true }
    }
    for event in &state.events {
        if event.kind == "action" && dunder_action(&json.Doc::parse_text(event.body)) { return true }
    }
    false
}

pub fn launch(dir: string, model: string, timeout_s: i64, check: string, root_entries: string, refs: &[]reference.Reference, interactive: bool, dunder_skill: bool, state: &session.Session) -> Result<process.Child, string> {
    rules_file := path.join(state.root, "AGENTS.md")
    mut rules := ""
    if !fs.is_symlink(rules_file) && sys.metadata(rules_file).is_file {
        instructions := sys.read_text_limit(rules_file, 65536)
        if !instructions.ok { return .Err("Could not read AGENTS.md (limit 64 KiB).") }
        rules = instructions.value
    }
    available := reference.names(&refs)
    skills := if dunder_skill { r#","skills":{"dunder":"# + json.quote(DUNDER_SKILL) + "}" } else { "" }
    input := r#"{"check":"# + json.quote(check) + r#","rootEntriesAtTurnStart":"# + json.quote(root_entries) + r#","interactive":"# + interactive.str() + r#","instructions":"# + json.quote(rules) + r#","references":"# + json.to_string(&available).unwrap() + skills + r#","events":"# + session.context(&state) + "}"
    ref := model_ref(model)?
    request := r#"{"model":"# + ref + r#","prompt":"# + json.quote(CONTRACT + "\n" + input) + "}"
    file := path.join(dir, "request.json")
    workspace.io_status(fs.write_private_text_atomic(file, request))?
    mut cmd := process.Command::new(sys.arg(0), ["--generate", file, timeout_s.str()])
    cmd.set_env("NO_PROXY", "*")
    cmd.set_env("no_proxy", "*")
    match cmd.spawn() { .Ok(c) => .Ok(move c), .Err(e) => .Err(e.message()), }
}

pub fn local_url(url: string) -> bool {
    prefix := "http://127.0.0.1:"
    if !text.starts_with(url, prefix) || url.len <= prefix.len { return false }
    for i in prefix.len..url.len { if url[i] < b'0' || url[i] > b'9' { return false } }
    port := parse.i64_range(url, prefix.len, url.len)
    port.ok && port.value > 0 && port.value <= 65535
}

fn request(body: &[]u8, registration: string, remaining_ms: i64) -> Result<http_client.Response, string> {
    data := sys.read_text_limit(registration, 8192)
    if !data.ok { return .Err("OpenCode service registration unavailable.") }
    service := json.Doc::parse_text(data.value)
    url := service.get_str(service.root, "url").unwrap_or_default()
    if !local_url(url) { return .Err("Expected an OpenCode service on IPv4 loopback.") }
    mut names: []string = ["Content-Type"]
    mut values: []string = ["application/json"]
    password := service.get_str(service.root, "password").unwrap_or_default()
    if password.len > 0 {
        names.push("Authorization")
        values.push("Basic " + base64.encode(&bytes.from_text("opencode:" + password)))
    }
    .Ok(http_client.request("POST", url + "/api/experimental/generate/text", &names, &values, &body, remaining_ms, 1048576))
}

pub fn generate(file: string, timeout_s: i64) -> Result<string, string> {
    deadline := clock.monotonic_ms() + timeout_s * 1000
    body := sys.read_u8_limit(file, 1048576)
    if !body.ok { return .Err("Could not read model request.") }
    base := process.env_or("XDG_STATE_HOME", path.join(process.env_or("HOME", ""), ".local/state"))
    reg := path.join(base, "opencode/service.json")
    for attempt in 0..2 {
        if attempt == 1 {
            mut cmd := process.Command::new("opencode", ["service", "start"])
            left := deadline - clock.monotonic_ms()
            if left <= 0 { return .Err(timed_out(timeout_s)) }
            cmd.set_timeout(cmp.min<i64>(12000, left))
            launched := cmd.exec()
            if launched.timed_out && clock.monotonic_ms() >= deadline { return .Err(timed_out(timeout_s)) }
            if !launched.succeeded() { return .Err("Could not start the local OpenCode service.") }
        }
        if !sys.metadata(reg).is_file { continue }
        left := deadline - clock.monotonic_ms()
        if left <= 0 { return .Err(timed_out(timeout_s)) }
        response := request(&body.value, reg, left)?
        if !response.ok {
            if response.transport_code == 28 { return .Err(timed_out(timeout_s)) }
            if attempt == 0 && response.transport_code == 7 { continue }
            return .Err(f"OpenCode connection failed (libcurl {response.transport_code}).")
        }
        data := bytes.decode(&response.body).unwrap_or_default()
        if response.status < 200 || response.status >= 300 {
            err := json.Doc::parse_text(data)
            reason := err.get_str(err.root, "reason").unwrap_or("error")
            msg := err.get_str(err.root, "message").unwrap_or("Check your OpenCode service version and model.")
            return .Err(f"OpenCode HTTP {response.status} ({reason}): " + workspace.clip(msg, 500))
        }
        return .Ok(data)
    }
    .Err("OpenCode service registration unavailable after start.")
}

pub fn decision(output: string) -> Result<string, string> {
    response := json.Doc::parse_text(output)
    data := response.field(response.root, "data")
    mut reply := text.trim(response.get_str(data, "text").unwrap_or_default())
    if text.starts_with(reply, "```json") && text.ends_with(reply, "```") && reply.len >= 10 { reply = text.trim(reply[7..reply.len - 3]) }
    doc := json.Doc::parse_text(reply)
    if !doc.ok || doc.get_str(doc.root, "tool").is_none() { return .Err("Expected a JSON decision with a tool name.") }
    .Ok(move reply)
}
