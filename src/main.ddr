capability filesystem, process, stdio, unsafe, network
import std.bytes as bytes
import std.fs as fs
import std.io as io
import std.parse as parse
import tui.text as rich
import .cli
import .mascot
import .engine
import .output
import .provider
import .reference
import .review
import .session
import .ui
import sys

@extern("c", "flock")
unsafe fn flock(fd: i32, operation: i32) -> i32

const HELP: string = """Dunder Agent
  dunder-agent [--workspace DIR] [--check COMMAND] [--resume ID]
  dunder-agent [options] run 'task'
  dunder-agent [options] run - < task.txt
  dunder-agent [--workspace DIR] changes SESSION_ID
  dunder-agent [--workspace DIR] show SESSION_ID
  --jsonl          Emit JSON Lines for run or show
  dunder-agent mascot
  --plain          Run without the terminal animation
  --model-timeout S  Seconds per model decision (default 140)
  --max-steps N    Decisions per user turn (default 24)
  --model ID       OpenCode provider/model or provider/model#variant
  --reference NAME=DIR  Add a named read-only directory (repeatable)
  --sessions       List local conversations for this workspace
  --resume ID      Reopen a saved conversation in the same workspace
  --check COMMAND  Local shell command GLM may run without another prompt"""

enum Inspect { None, Changes, Show }

struct Options { references: []reference.Reference, root: string, model: string, timeout_s: i64, check: string, id: string, steps: i32, prompt: string, batch: bool, list: bool, plain: bool, mascot: bool, inspect: Inspect, jsonl: bool }

fn stdin_task() -> Result<string, string> {
    if io.stdin().is_tty() { return .Err("run - reads a piped UTF-8 task from standard input.") }
    raw := match io.read_stdin_limit(engine.MAX_TASK_BYTES) {
        .Ok(buf) => move buf,
        .Err(e) => { return .Err(if e == .TooLarge { engine.TASK_TOO_LARGE } else { "Could not read standard input: " + e.message() }) },
    }
    match bytes.decode(&raw) { .Ok(value) => .Ok(value), .Err(_) => .Err("Task is not valid UTF-8."), }
}

fn options() -> Result<Options, string> {
    mut o := Options { references: [], root: ".", model: provider.MODEL, timeout_s: provider.DEFAULT_TIMEOUT, check: "", id: "", steps: 24, prompt: "", batch: false, list: false, plain: false, mascot: false, inspect: .None, jsonl: false }
    mut i := 1
    while i < sys.arg_count() {
        name := sys.arg(i)
        i += 1
        if name == "mascot" { o.mascot = true; continue }
        if name == "--plain" { o.plain = true; continue }
        if name == "--jsonl" { o.jsonl = true; continue }
        if name == "--sessions" { o.list = true; continue }
        if i >= sys.arg_count() { return .Err("Missing value for " + name) }
        arg := sys.arg(i)
        i += 1
        match name {
            "--reference" => { reference.add(&mut o.references, arg)? },
            "--workspace" => { o.root = arg },
            "--model" => { _ := provider.model_ref(arg)?; o.model = arg },
            "--check" => { o.check = arg },
            "--resume" => {
                if o.id != "" { return .Err("Select one session.") }
                o.id = arg
            },
            "changes" | "show" => {
                if o.id != "" || arg == "" { return .Err("Pass one session ID after " + name + ".") }
                o.id = arg
                o.inspect = if name == "changes" { Inspect.Changes } else { Inspect.Show }
            },
            "--model-timeout" => { o.timeout_s = provider.timeout_seconds(arg)? },
            "--max-steps" => {
                parsed := parse.i64_range(arg, 0, arg.len)
                if !parsed.ok || parsed.value < 1 || parsed.value > 128 { return .Err("Expected 1..128 decisions.") }
                o.steps = i32(parsed.value)
            },
            "run" => {
                if o.batch { return .Err("Pass one quoted task after run.") }
                o.batch = true
                o.prompt = arg
            },
            _ => { return .Err("Unknown option " + name) },
        }
    }
    if o.inspect != .None && (o.list || o.batch) { return .Err("Inspect one session separately from a turn or session list.") }
    if o.jsonl && !o.batch && o.inspect != .Show { return .Err("--jsonl requires run or show.") }
    if o.mascot && (o.batch || o.list || o.id != "") { return .Err("Run mascot separately from a session.") }
    if o.list && (o.batch || o.id != "") { return .Err("--sessions cannot start or resume a turn.") }
    if o.batch {
        if o.prompt == "-" { o.prompt = stdin_task()? }
        engine.validate_task(o.prompt)?
    }
    .Ok(o)
}

fn drive(o: &Options) -> Result<(), string> {
    root := fs.realpath(o.root)
    if !root.ok || !sys.metadata(root.value).is_dir { return .Err("Workspace is not a directory.") }
    if o.list {
        rows := session.list(root.value)?
        for row in &rows { print(engine.safe(row)) }
        return .Ok
    }
    if o.inspect != .None {
        file := session.file_for(session.state_dir(), o.id)?
        saved := session.resume(file, root.value)?
        if o.inspect == .Show { return cli.show(o.id, &saved, o.jsonl) } else { print(review.changes(&saved)) }
        return .Ok
    }
    scratch := fs.temp_dir("dunder-agent-")
    if !scratch.ok { return .Err("Could not create private runtime directory.") }
    defer { _ := fs.remove_all(scratch.value) }
    dir := session.directory()?
    id := if o.id == "" { f"{sys.now_ms()}-{sys.pid()}" } else { o.id.clone() }
    file := session.file_for(dir, id)?
    mut lock_opts := fs.OpenOptions::read_write()
    lock_opts.set_create(true)
    lock_opts.set_mode(384)
    mut lock := match fs.File::open(file + ".lock", lock_opts) { .Ok(f) => move f, .Err(e) => { return .Err(e.message()) }, }
    unsafe { if flock(lock.fd(), 6) != 0 { return .Err("Session already open.") } }
    mut history := if o.id == "" { session.Session { root: root.value.clone(), events: [] } } else { session.resume(file, root.value)? }
    start := history.events.len
    if history.events.len > 0 && history.events[history.events.len - 1].kind == "action" {
        session.record(&mut history, file, "notice", "Last action was interrupted. Check its effects before retrying.")?
    }
    mut s := ui.Screen {
        run: engine.Run {
            references: o.references.clone(), history: move history, file: file.clone(), scratch: scratch.value.clone(), model: o.model.clone(), model_timeout_s: o.timeout_s, check: o.check.clone(), root_entries: "",
            interactive: !o.batch, phase: .Idle, child: [], stdout: output.Stream::new(), stderr: output.Stream::new(), since: 0, steps: 0, max_steps: o.steps,
            needs_check: false, bad_check: false, corrections: 0, pending: "", status: "Ready", failed: false
        },
        input: "", scroll: 0, session_id: id.clone(), motion: !o.plain, elapsed: if o.plain { i64(1100) } else { i64(0) }, rendered_events: -1, reviewing: false, journal: rich.Paragraph::raw("").prepare(1),
    }
    session.save(file, &s.run.history)?
    if !o.jsonl { _ := sys.eprint("Session " + id) }
    if !o.batch { return ui.show(&mut s) }
    outcome := cli.batch(&mut s.run, id, o.prompt, o.plain, o.jsonl, start)
    _ := lock.close()
    outcome
}

fn main() -> i32 {
    if sys.arg_count() == 2 && (sys.arg(1) == "--version" || sys.arg(1) == "-V") { print("dunder-agent 0.9.0"); return 0 }
    if sys.arg_count() == 2 && (sys.arg(1) == "--help" || sys.arg(1) == "-h") { print(HELP); return 0 }
    if (sys.arg_count() == 3 || sys.arg_count() == 4) && sys.arg(1) == "--generate" {
        seconds := if sys.arg_count() == 3 { provider.DEFAULT_TIMEOUT } else {
            match provider.timeout_seconds(sys.arg(3)) { .Ok(n) => n, .Err(e) => { _ := sys.eprint(e); return 2 }, }
        }
        return match provider.generate(sys.arg(2), seconds) { .Ok(raw) => { print(raw); 0 }, .Err(e) => { _ := sys.eprint(e); 1 }, }
    }
    o := match options() { .Ok(opts) => opts, .Err(e) => { _ := sys.eprint(e); return 2 }, }
    if o.mascot {
        return match mascot.show(o.plain) { .Ok => 0, .Err(e) => { _ := sys.eprint(e); 1 }, }
    }
    match drive(&o) { .Ok => 0, .Err(e) => { _ := sys.eprint(engine.safe(e)); 1 }, }
}
